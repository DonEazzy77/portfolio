---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Private Visitenkarte — nur über den QR auf Karte/Flyer erreichbar (Token-URL /k/tw0fxluu/).
// noindex, nicht in der Sitemap, von nirgends verlinkt. Voller vCard-Download liegt unter
// /k/tw0fxluu/kontakt.vcf (nicht im öffentlichen Web-Root erratbar verlinkt).
const tel = '+49 7721 9161046';
const telHref = 'tel:+4977219161046';
const mail = 'me@torsten-guenter.de';
---

<BaseLayout
  title="Visitenkarte — Torsten Günter"
  description="Digitale Visitenkarte von Torsten Günter – Online Marketing & E-Commerce Manager. Kontakt direkt speichern, anrufen oder schreiben."
  noindex={true}
>
  <section class="max-w-md mx-auto px-4 sm:px-6 pt-16 pb-16 sm:pt-20">
    <!-- Kontaktkarte -->
    <div class="rounded-2xl border border-border-subtle bg-primary-soft/60 px-6 py-10 sm:px-8 text-center shadow-sm">
      <img
        src="/apple-touch-icon.png"
        width="80"
        height="80"
        alt="Wappen-Badge von Torsten Günter"
        class="mx-auto mb-6 h-20 w-20 rounded-2xl shadow-sm"
      />

      <h1 class="font-serif text-3xl sm:text-4xl font-medium text-text-primary leading-tight">
        Torsten Günter
      </h1>

      <p class="mt-3 text-xs sm:text-sm tracking-[0.18em] uppercase text-text-secondary">
        Online Marketing &amp; E-Commerce Manager
      </p>

      <p class="mt-4 font-serif text-lg text-primary">
        Marketing &amp; E-Commerce mit technischer DNA.
      </p>

      <!-- Primäre Aktion: Kontakt speichern (vCard) -->
      <a
        href="/k/tw0fxluu/kontakt.vcf"
        download
        class="mt-8 flex w-full items-center justify-center gap-2 rounded-lg bg-primary px-6 py-3.5 text-sm font-medium text-white transition-colors hover:bg-primary-hover"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><line x1="19" y1="8" x2="19" y2="14" /><line x1="22" y1="11" x2="16" y2="11" />
        </svg>
        Kontakt speichern
      </a>

      <!-- Sekundäre Aktionen -->
      <div class="mt-3 grid grid-cols-2 gap-3">
        <a
          href={telHref}
          class="flex items-center justify-center gap-2 rounded-lg border border-primary/30 px-4 py-3 text-sm font-medium text-primary transition-colors hover:bg-primary/5"
        >
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" />
          </svg>
          Anrufen
        </a>
        <a
          href={`mailto:${mail}`}
          class="flex items-center justify-center gap-2 rounded-lg border border-primary/30 px-4 py-3 text-sm font-medium text-primary transition-colors hover:bg-primary/5"
        >
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-10 5L2 7" />
          </svg>
          E-Mail
        </a>
      </div>

      <div class="mt-3 grid grid-cols-2 gap-3">
        <a
          href="https://torsten-guenter.de"
          class="flex items-center justify-center gap-2 rounded-lg border border-primary/30 px-4 py-3 text-sm font-medium text-primary transition-colors hover:bg-primary/5"
        >
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10" /><path d="M2 12h20" /><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
          </svg>
          Website
        </a>
        <a
          href="https://www.linkedin.com/in/torsten-guenter"
          rel="me"
          class="flex items-center justify-center gap-2 rounded-lg border border-primary/30 px-4 py-3 text-sm font-medium text-primary transition-colors hover:bg-primary/5"
        >
          <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.8 0 0 .78 0 1.74v20.52C0 23.22.8 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.74V1.74C24 .78 23.2 0 22.22 0z" />
          </svg>
          LinkedIn
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
