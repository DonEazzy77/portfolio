---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';

import shot7milesDesktop from '../../assets/showcase/7miles-desktop.png';
import shot7milesMobile from '../../assets/showcase/7miles-mobile.png';
import shot7milesKlassen from '../../assets/showcase/7miles-unterseite.png';

// Nachzügler 7miles (Biz 21.08.): /klassen-Hero wird neu gerendert, das Schild
// zeigt die falsche Crest-Variante. Der Tausch ist ein reiner Dateitausch —
// die beiden PNGs unten ersetzen, sonst nichts. Caption und Alt zu Motiv 1
// stehen isoliert im ersten Eintrag von galerie.bilder.
//   7miles-unterseite.png     (A3, Screenshot der Seite /klassen)
//   7miles-hero-klassen.png   (Galerie-Motiv 1)
import heroKlassen from '../../assets/showcase/7miles-hero-klassen.png';
import heroAktuelles from '../../assets/showcase/7miles-hero-aktuelles.png';
import heroUeberuns from '../../assets/showcase/7miles-hero-ueberuns.png';
import heroKontakt from '../../assets/showcase/7miles-hero-kontakt.png';
import heroSchnupper from '../../assets/showcase/7miles-hero-schnupperstunde.png';
import hero404 from '../../assets/showcase/7miles-hero-404.png';

import tafelW1 from '../../assets/showcase/7miles-w1-rebrand.png';
import tafelW3 from '../../assets/showcase/7miles-w3-print.png';
import tafelW4 from '../../assets/showcase/7miles-w4-localseo.png';
import flyerAllgemein from '../../assets/showcase/7miles-flyer-allgemein-front.png';
import flyerAnfaenger from '../../assets/showcase/7miles-flyer-anfaenger-front.png';
import flyerMotorrad from '../../assets/showcase/7miles-flyer-motorrad-front.png';
import flyerWiedereinstieg from '../../assets/showcase/7miles-flyer-wiedereinstieg-front.png';
import flyerRueck from '../../assets/showcase/7miles-flyer-rueck.png';
import schildVisual from '../../assets/showcase/7miles-w3-leuchtschild.png';
// ── CASE 3: Fahrschule 7miles ──────────────────────────────────────────────
// Eigenes Case-Objekt, bewusst NICHT die Arrays von Case 1 erweitert (die sind an
// Case 1 gebunden; Auftrag § 4 / Befund § 2).
//
// Copy 1:1 aus selbststaendigkeit/case_study_7miles_entwurf.md v0.4
// (Torsten-Go 20.08.2026, S&R-Kurzpass grün, Nachtrag XLIII). Hier wird kein Wort
// redaktionell geändert — Textfehler werden an Biz gemeldet, nicht behoben.
//
// vorherBild (A4), crest (A5) und zitat (A8) sind bewusst null: die zugehörigen
// Blöcke rendern nur, wenn ein Wert gesetzt ist. Aktivierung = Wert eintragen,
// kein Markup-Umbau, keine Platzhalter-Optik im Live-Output.
const siebenMeilen = {
  eyebrow: 'Kundenprojekt · Fahrschule · 2026',
  titel: 'Fahrschule 7miles',
  disziplinen: 'Rebrand · Website-Neubau · Local SEO · Print',
  lead: 'Die Website, die nicht ums Auto geht. Eine Fahrschule im Schwarzwald-Baar-Kreis, ein Fahrlehrer, drei sehr verschiedene Arten von Fahrschülern: Jugendliche, bei denen die Eltern mitentscheiden, Motorradfahrer mit eigenem Kopf, und Menschen, die nach Jahren wieder einsteigen und vor allem eines brauchen — Vertrauen. Die neue Marke und die statische Website sprechen alle drei an, ohne sich für eine zu entscheiden, und zeigen endlich, was vor Ort längst da war: ein Schulungsraum, der eher nach Lounge aussieht. Technisch steht die Seite auf dem Smartphone in unter zwei Sekunden, kommt ohne ein einziges Cookie aus und zieht das Google-Profil der Fahrschule gleich mit. Von der ersten Konzeptseite im Mai bis zum Livegang im August 2026.',
  ausgangslage: 'Die Fahrschule hatte längst Charakter — ein Innenraum wie eine Lounge-Bar, ein persönlicher Fahrlehrer, eine handgeschriebene grüne 7 auf der Motorhaube. Nur online kam davon nichts an: Website, Fahrzeug und Drucksachen erzählten drei verschiedene Geschichten.',
  ziel: 'Eine Marke, die auf Fahrzeugfolie, Postkarte und Smartphone dieselbe ist. Eine Website, die auf dem Handy schnell ist, für alle zugänglich, ohne Tracking, und die in der lokalen Suche sauber auffindbar bleibt — inklusive Weiterleitungen aller alten Adressen.',

  // Block „Was gemacht wurde" — Copy v0.5 § 1, Wortlaut 1:1. In der Copy als bedingt
  // markiert, im Bau-Auftrag § 1 zunächst nicht gelistet; von Biz am 21.08. nachbeauftragt
  // (Auslassung im Auftrag, S&R hatte den Block mitgeprüft — keine neue Runde).
  gemacht: [
    { t: 'Marke',            d: 'Wortmarke, Crest, Farbsystem (Asphalt, Granit, Stahl, Beton, Volt) — angewendet auf Print, Merch, Fahrzeug, Stempel, Fensterfolie.' },
    { t: 'Website',          d: 'statischer Neubau (Astro, Tailwind), 8 Seiten + 404, Redirect-Karte der Alt-URLs.' },
    { t: 'Inhalt',           d: 'Du-Ton-Konzept, Textqualitätssicherung in 13 dokumentierten Runden.' },
    { t: 'Technik',          d: 'eigene Bild-Pipeline (AVIF/WebP in acht Breiten), selbst gehostete Schriften, strukturierte Daten (LocalBusiness), Sitemap, Search Console.' },
    { t: 'Barrierefreiheit', d: 'Kontraste, Trefflächen, Skip-Link, aria-Prüfung.' },
    { t: 'Local SEO',        d: 'Google-Unternehmensprofil überarbeitet; Rezensions-Funnel über /bewerten bis auf die Postkarte „Bestanden".' },
  ],

  // ── Werkschau: pro Disziplin ein Beleg ────────────────────────────────────
  // Copy 1:1 aus selbststaendigkeit/werkschau_7miles_copy.md v0.3
  // (S&R-Kurzpass grün XLVII, Torsten-Go 21.08.). Tafeln sind Kompositionen
  // aus Daniels Übergabemappe — Quellen je Tafel im Plan § B.
  //
  // Reihenfolge hier: W1 Rebrand · W2 Website · W3 Print · W4 Local SEO.
  // Plan § A verlangt die Reihenfolge der Disziplinen-Zeile (… Local SEO · Print);
  // das steht quer zur W-Nummerierung. Gebaut ist die Nummerierung, weil der
  // Design-Anspruch-Satz in W4 als Schluss gedacht ist. An Biz gemeldet.
  werkschau: {
    w1: {
      titel: 'Von der Sieben auf der Motorhaube zum System',
      text: 'Auf dem Schulwagen stand schon lange eine handgeschriebene grüne 7 — das einzige Markenstück, das jeder kannte. Sie wurde nicht ersetzt, sondern weitergebaut: ein rundes Crest für Stempel, Schild und Fenster, eine Wortmarke für alles, was Zeile braucht, vier Farbwelten von Neon-Volt bis Druck-Volt fürs Papier. Jede Variante ist so gezeichnet, dass sie in 45 Millimetern Stempelrund genauso hält wie an der Fassade.',
      alt: 'Logo-System der Fahrschule 7miles: rundes Crest und Wortmarke in je vier Farbvarianten, darunter die Markenfarben Volt-Grün, Asphalt und Beton.',
    },
    w3: {
      titel: 'Ein System, das man in die Hand nehmen kann',
      // Leuchtschild-Visual (Klinker, Torsten 24.08.). SCHALTER AUS, bis die
      // Label-Zeile von Biz vorliegt — ein KI-Bild ohne Kennzeichnung darf
      // nicht live (S&R). Aktivierung: schild auf { src: schildVisual, label:
      // '<Wortlaut Biz>', alt: '<Wortlaut Biz>' } setzen. Kein Markup-Umbau.
      schild: null,
      text: 'Visitenkarte, zwei Stempel, Gutscheinkarte, dazu Briefpapier, Rechnungsvorlage, E-Mail-Signatur, Standby-Bilder für den Beamer im Schulungsraum und vier Flyer aus einem Bausatz. Alles aus denselben Bausteinen, alles druckfertig mit Beschnitt übergeben.',
      alt: 'Drucksachen der Fahrschule 7miles: zweiseitige Visitenkarte, Rechteck- und Rundstempel mit Crest, Gutscheinkarte für eine kostenlose Schnupperstunde.',
      // Flyer-Faecher — Copy Biz 24.08.2026, Wortlaut 1:1, nicht umformuliert.
      // Vier Fronten plus die gemeinsame Rueckseite. Die Fremdfoto-Grenze fuer
      // 7miles ist aufgehoben (Biz 24.08., Fakt von Torsten: Daniel hat die Fotos
      // der Alt-Website selbst gemacht). Bild-Regel (Biz-Korrektur 24.08.):
      // Kriterium ist ABGENOMMEN + RECHTE GEKLAERT, nicht "live". Fotografien nur
      // aus geklaerter Quelle, im Zweifel der abgenommene Live-Stand; eigene
      // Gestaltungs-Artefakte duerfen aus der Ablage kommen, auch wenn nie online.
      // GEMELDET, Antwort steht aus: der Alt-Text sagt "helle Rueckseite" — die
      // Flyer-Rueckseite ist dunkel (Asphalt). Wortlaut bleibt bis zur Korrektur.
      flyer: {
        titel: 'Vier Flyer, ein Bausatz',
        text: 'Ein allgemeiner Flyer, dazu je einer für Fahranfänger, Motorrad und Wiedereinstieg — gleiche Architektur, pro Zielgruppe eine eigene Bildwelt und Ansprache. Die ganze Serie kommt aus einem Skript: Inhalte wechseln, das Design bleibt.',
        alt: 'Vier aufgefächerte Flyer der Fahrschule 7miles mit dunkler Vorderseite und Crest, dahinter eine helle Rückseite mit Text und QR-Code.',
      },
    },
    w4: {
      titel: 'Vom bestandenen Führerschein zur Google-Bewertung',
      text: 'Local SEO hört nicht bei Unternehmensprofil, strukturierten Daten und Sitemap auf. Die Postkarte schließt den Kreis: bestanden → Karte in der Hand → QR → Google-Bewertung. Vorne das Diner mit „Bestanden" in Leuchtschrift, hinten die Bitte um zwei Minuten und ein Code, der direkt auf fahrschule7miles.de/bewerten führt. Das Leuchtschild zeigt das Crest nicht eins zu eins, sondern in einer eigenen Neon-Fassung: Röhren können keine Sterne in dieser Größe biegen, und ein Ring braucht Unterbrechungen, wo das Glas beginnt und endet. Darum drei Striche statt Sterne, ein offener Innenring, eine kantige Sieben — gleiches Zeichen, andere Bauweise. Das Angebot für das Schild liegt vor.',
      alt: 'Crest der Fahrschule 7miles als grünes Neonschild-Rendering auf Ziegelwand; daneben Postkarte „Bestanden" mit nächtlichem Diner vorne und Bewertungs-QR-Code hinten.',
      label: 'Postkartenmotiv KI-generiert · Konzept, Bildregie und Auswahl: Torsten Günter · Leuchtschild: Rendering.',
    },
  },

  drehTitel: 'Der Dreh nach dem Launch',
  dreh: 'Am Launchtag stand die neue Seite mit Performance 74 auf der Seite „Klassen": sieben Galerie-Vorschaubilder kamen als Vollformat-Fotos für 64-Pixel-Kästchen, ein Stylesheet blockierte das Rendern, ein Preload zeigte auf eine Datei, die der Browser nie nutzte. Zwei Tage später: 385 statt 2.032 KiB, LCP von 8,6 auf unter 2 Sekunden, Performance 99–100. Die Seite war vorher nicht schlecht — sie wurde gemessen, verstanden und fertig gemacht.',
  drehBeleg: 'Gemessen 15. und 17.08.2026, Lighthouse in Chrome DevTools, mobil, fahrschule7miles.de/klassen',

  kpis: [
    { k: '4 × 100', v: 'Lighthouse Startseite, mobil & desktop' },
    { k: '385 KiB', v: 'statt 2.032 KiB — Seite „Klassen", Launch → Optimierung' },
    { k: '0 Cookies', v: 'keine Fremd-Requests, kein Tracking — alle Seiten' },
    { k: '8 Seiten', v: 'Neubau, alle Alt-Adressen weitergeleitet' },
  ],
  // Pflicht neben K1 (Auftrag § 1.6). Sichtbarer Kleintext statt title-Attribut:
  // ein title-Tooltip erscheint weder auf Touch noch bei Tastaturbedienung.
  kpiBeleg: 'https://fahrschule7miles.de/ · Mobil + Desktop · 20.08.2026 · Lighthouse 13.4.0 (CLI, headless), Median aus je 5 Läufen',

  designAnspruch: 'Das Crest ist so gezeichnet, dass es als Leuchtreklame funktioniert: gleiche Strichstärken, bewusste Unterbrechungen, eine kantige Sieben.',

  link: {
    href: 'https://fahrschule7miles.de',
    label: 'fahrschule7miles.de ansehen',
    aria: 'Website der Fahrschule 7miles öffnen (neues Fenster)',
  },

  shots: [
    { src: shot7milesDesktop, alt: 'Startseite der Fahrschule 7miles auf einem Desktop-Bildschirm: dunkler Hintergrund, grüne Akzentfarbe, Crest und Einstieg zur Schnupperstunde.' },
    { src: shot7milesMobile,  alt: 'Dieselbe Startseite auf dem Smartphone, Menü und Schnupperstunden-Button oben erreichbar.' },
    { src: shot7milesKlassen, alt: 'Seite Klassen der Fahrschule 7miles mit Übersicht der Führerscheinklassen und Galerie.' },
  ],

  // Galerie „Route 7" — Copy v0.2 (S&R grün, Nachtrag XLV), Wortlaut 1:1.
  // Reihenfolge: Menü-Folge der 7miles-Seite, danach die beiden Sonderplatzierungen.
  // Schalter AN seit Torsten-Entscheid 21.08. (Daniels Einverständnis war Teil des
  // Pitches → kein Kundenassets-Schalter). Auf false setzen blendet den Block aus.
  galerieAn: true,
  galerie: {
    titel: 'Route 7 — eine Bildserie für sechs Seiten',
    intro: 'Jede Seite der Fahrschule bekam ihr eigenes Motiv aus derselben Welt: eine leere Straße in der Dämmerung, ein grüner Schimmer am Horizont, der nie erklärt wird, und ein Präriehund, der immer abseits der Fahrbahn sitzt und zuschaut. Entstanden als KI-generierte Serie nach eigener Bildregie.',
    label: 'KI-generierte Bildserie · Konzept, Bildregie und Auswahl: Torsten Günter · Kein Foto.',
    bilder: [
      { src: heroKlassen, stark: 'Alle Klassen aus einer Hand.',
        text: 'Mofa, Roller, zwei Maschinen und ein alter Wagen vor dem Diner — im Fenster das Neonschild, genau so, wie es gebaut wird.',
        alt: 'Mofa, Roller, zwei Motorräder und ein Oldtimer vor einem Chrom-Diner in der Dämmerung, im Fenster ein grünes Neonschild mit der 7, links ein Präriehund.' },
      { src: heroAktuelles, stark: 'Was bei uns gerade läuft.',
        text: 'Die Präriehund-Familie vor ihrem Bau in der Abenddämmerung — einer steht schon, die anderen schauen noch.',
        alt: 'Präriehund-Familie auf einem Erdhügel in der Abenddämmerung, daneben eine leere Landstraße mit grünem Schimmer am Horizont.' },
      { src: heroUeberuns, stark: 'Seit 2007 auf der Straße.',
        text: 'Die Werkstatt bei Nacht: Vespas, eine abgedeckte Maschine, ein alter Mustang — der Ort, an dem die Fahrschule zuhause ist.',
        alt: 'Werkstatt bei Nacht mit zwei Vespas, einem schwarzen Mustang und einem grünen Neonschild an der Wand.' },
      { src: heroKontakt, stark: 'Einfach anrufen.',
        text: 'Eine Telefonzelle in der blauen Stunde, die einzige warme Lichtquelle weit und breit.',
        alt: 'Beleuchtete Telefonzelle am Rand einer leeren Landstraße zur blauen Stunde, ein Präriehund sitzt davor.' },
      { src: heroSchnupper, stark: 'Erst schnuppern, dann anmelden.',
        text: 'Der Präriehund richtet sich am Kilometerstein auf — die grüne 7 leuchtet schon.',
        alt: 'Präriehund richtet sich an einem Kilometerstein mit leuchtender grüner 7 auf, Sonnenuntergang über der Straße.' },
      { src: hero404, stark: 'Hier geht\'s nicht weiter.',
        text: 'Sackgassen-Schild, Laterne, Präriehund auf dem Felsen — selbst die Fehlerseite gehört zur Serie.',
        alt: 'Nächtliche Landstraße mit Sackgassen-Schild unter einer Laterne, grüner Schimmer am Horizont, Präriehund auf einem Felsen.' },
    ],
  },

  vorherBild: null,   // A4 — erst nach Daniel-OK + Motivprüfung
  crest: null,        // A5 — erst nach Daniel-OK pro forma
  zitat: null,        // A8 — erst nach O-Ton Daniel
};
---

<BaseLayout
  title="Fahrschule 7miles: Rebrand & Website-Relaunch — Torsten Günter"
  description="Case Study: neue Marke, statische Website mit Lighthouse 4 × 100, ohne Cookies, Print und Local SEO für eine Fahrschule im Schwarzwald-Baar-Kreis."
  ogTitle="Fahrschule 7miles: Rebrand & Website-Relaunch · Torsten Günter"
  ogDescription="Case Study: neue Marke, statische Website mit Lighthouse 4 × 100, ohne Cookies, Print und Local SEO für eine Fahrschule im Schwarzwald-Baar-Kreis."
>
  <div class="py-16 md:py-24 lg:py-32">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">

      {/* Breadcrumb — eine Ebene, deshalb schlicht als Zeile mit Trenner */}
      <nav aria-label="Brotkrumen" class="text-sm text-text-secondary mb-8">
        <a href="/arbeiten/" class="krumen-link">Arbeiten</a>
        <span aria-hidden="true" class="mx-2">→</span>
        <span class="text-text-primary">Fahrschule 7miles</span>
      </nav>

      <div class="bg-background border border-border-subtle rounded-lg p-6 sm:p-10">

        <p class="text-xs tracking-[0.18em] uppercase text-text-secondary mb-3">{siebenMeilen.eyebrow}</p>
        <h2 class="font-serif text-2xl sm:text-3xl font-medium text-text-primary leading-tight mb-3">
          {siebenMeilen.titel}
        </h2>
        <p class="text-sm text-text-secondary mb-6">{siebenMeilen.disziplinen}</p>

        <p class="text-base text-text-primary leading-relaxed spalten-2 mb-10">{siebenMeilen.lead}</p>

        {/* Ausgangslage / Ziel — gleiches Muster wie Case 1 */}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 mb-10">
          <div>
            <div class="w-8 h-[3px] bg-primary rounded-full mb-4" aria-hidden="true"></div>
            <h3 class="font-serif text-lg font-medium text-text-primary mb-2">Ausgangslage</h3>
            <p class="text-sm text-text-secondary leading-relaxed">{siebenMeilen.ausgangslage}</p>
          </div>
          <div>
            <div class="w-8 h-[3px] bg-primary rounded-full mb-4" aria-hidden="true"></div>
            <h3 class="font-serif text-lg font-medium text-text-primary mb-2">Ziel</h3>
            <p class="text-sm text-text-secondary leading-relaxed">{siebenMeilen.ziel}</p>
          </div>
        </div>

        {/* Was gemacht wurde — Zweispalter im Rhythmus von Ausgangslage/Ziel */}
        <h3 class="font-serif text-lg font-medium text-text-primary mb-5">Was gemacht wurde</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-5 mb-10">
          {siebenMeilen.gemacht.map((g) => (
            <div>
              <p class="text-[15px] font-semibold text-text-primary mb-1">{g.t}</p>
              <p class="text-sm text-text-secondary leading-relaxed">{g.d}</p>
            </div>
          ))}
        </div>

        {/* A4 — Vorher-Bild. Rendert nur mit gesetztem Wert; sonst existiert hier nichts. */}
        {siebenMeilen.vorherBild && (
          <figure class="shot shot-wide mb-10">
            <Image src={siebenMeilen.vorherBild.src} alt={siebenMeilen.vorherBild.alt}
                   width={1440} widths={[640, 960, 1440]} sizes="(min-width: 640px) 900px, 100vw"
                   format="webp" quality={72} loading="lazy" />
          </figure>
        )}


        {/* W1 · Rebrand */}
        <figure class="tafel">
          <Image src={tafelW1} alt={siebenMeilen.werkschau.w1.alt}
                 widths={[720, 1080, 1440]} sizes="(min-width: 1024px) 860px, 100vw"
                 format="webp" quality={74} loading="lazy" />
        </figure>
        <h3 class="font-serif text-lg font-medium text-text-primary mt-6 mb-3">{siebenMeilen.werkschau.w1.titel}</h3>
        <p class="text-sm text-text-secondary leading-relaxed max-w-2xl mb-12">{siebenMeilen.werkschau.w1.text}</p>

        {/* Screenshots: Desktop breit, darunter Mobil (Hochformat) neben /klassen */}
        <div class="mb-10 flex flex-col gap-4">
          <figure class="shot">
            <Image src={siebenMeilen.shots[0].src} alt={siebenMeilen.shots[0].alt}
                   width={1440} widths={[640, 960, 1440]} sizes="(min-width: 1024px) 880px, 100vw"
                   format="webp" quality={72} loading="lazy" />
          </figure>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 items-start">
            <figure class="shot">
              <Image src={siebenMeilen.shots[1].src} alt={siebenMeilen.shots[1].alt}
                     width={600} widths={[300, 600]} sizes="(min-width: 640px) 290px, 100vw"
                     format="webp" quality={72} loading="lazy" />
            </figure>
            <figure class="shot sm:col-span-2">
              <Image src={siebenMeilen.shots[2].src} alt={siebenMeilen.shots[2].alt}
                     width={1200} widths={[600, 1200]} sizes="(min-width: 640px) 580px, 100vw"
                     format="webp" quality={72} loading="lazy" />
            </figure>
          </div>
        </div>

        {/* Der Dreh nach dem Launch — Beleg-Zeile direkt darunter, damit die Zahlen
            nie ohne ihre Messangabe stehen (Messrunde 15./17.08., nicht die vom 20.08.) */}
        <h3 class="font-serif text-lg font-medium text-text-primary mb-3">{siebenMeilen.drehTitel}</h3>
        <p class="text-sm text-text-secondary leading-relaxed max-w-2xl mb-2">{siebenMeilen.dreh}</p>
        <p class="text-xs text-text-secondary/80 leading-relaxed max-w-2xl mb-10">{siebenMeilen.drehBeleg}</p>

        {/* Kennzahlen — Raster wie Case 1 */}
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
          {siebenMeilen.kpis.map((e, i) => (
            <div class="bg-background-soft border border-border-subtle rounded-lg p-5 text-center"
                 aria-describedby={i === 0 ? 'kpi-beleg-7miles' : undefined}>
              <p class="font-serif text-2xl sm:text-3xl text-primary mb-1">{e.k}</p>
              <p class="text-xs text-text-secondary leading-snug">{e.v}</p>
            </div>
          ))}
        </div>
        <p id="kpi-beleg-7miles" class="text-xs text-text-secondary/80 leading-relaxed mt-3">{siebenMeilen.kpiBeleg}</p>

        {/* W3 · Print & Ausstattung — Bild folgt dem Text, den es belegt. */}
        <h3 class="font-serif text-lg font-medium text-text-primary mt-6 mb-3">{siebenMeilen.werkschau.w3.titel}</h3>
        <p class="text-sm text-text-secondary leading-relaxed max-w-2xl mb-6">{siebenMeilen.werkschau.w3.text}</p>
        <figure class="tafel mb-12">
          <Image src={tafelW3} alt={siebenMeilen.werkschau.w3.alt}
                 widths={[720, 1080, 1440]} sizes="(min-width: 1024px) 860px, 100vw"
                 format="webp" quality={74} loading="lazy" />
        </figure>

        {/* Flyer-Faecher — belegt die Serie, ohne Galerie und ohne Lightbox.
            Nicht klickbar; eine Sammelbeschreibung am Container statt vier
            Einzel-Alts, sonst liest der Screenreader viermal dasselbe. */}
        <h3 class="font-serif text-lg font-medium text-text-primary mt-6 mb-3">{siebenMeilen.werkschau.w3.flyer.titel}</h3>
        <p class="text-sm text-text-secondary leading-relaxed max-w-2xl mb-6">{siebenMeilen.werkschau.w3.flyer.text}</p>
        <div class="faecher mb-12" role="img" aria-label={siebenMeilen.werkschau.w3.flyer.alt}>
          <Image class="fl fl-a" src={flyerWiedereinstieg} alt="" widths={[240, 480]} sizes="19vw" format="webp" quality={72} loading="lazy" />
          <Image class="fl fl-b" src={flyerMotorrad} alt="" widths={[260, 520]} sizes="21vw" format="webp" quality={72} loading="lazy" />
          <Image class="fl fl-c" src={flyerAllgemein} alt="" widths={[320, 640]} sizes="26vw" format="webp" quality={74} loading="lazy" />
          <Image class="fl fl-d" src={flyerRueck} alt="" widths={[320, 640]} sizes="26vw" format="webp" quality={74} loading="lazy" />
          <Image class="fl fl-e" src={flyerAnfaenger} alt="" widths={[260, 520]} sizes="21vw" format="webp" quality={72} loading="lazy" />
        </div>

        {/* Leuchtschild — eigenes Element neben den Drucksachen, weil es ein
            eigener Gegenstand ist. Rendert nur mit gesetztem Wert samt Label. */}
        {siebenMeilen.werkschau.w3.schild && (
          <figure class="tafel mb-12">
            <Image src={siebenMeilen.werkschau.w3.schild.src} alt={siebenMeilen.werkschau.w3.schild.alt}
                   widths={[720, 1080, 1440]} sizes="(min-width: 1024px) 860px, 100vw"
                   format="webp" quality={74} loading="lazy" />
            <figcaption class="text-xs text-text-secondary/80 leading-relaxed mt-3">
              {siebenMeilen.werkschau.w3.schild.label}
            </figcaption>
          </figure>
        )}

        {/* W4 · Local SEO — hierher wandert der Design-Anspruch-Satz: das Neon-Bild
            steht direkt daneben (Plan § B). */}
        <h3 class="font-serif text-lg font-medium text-text-primary mt-6 mb-3">{siebenMeilen.werkschau.w4.titel}</h3>
        <p class="text-sm text-text-secondary leading-relaxed spalten-2 mb-3">{siebenMeilen.werkschau.w4.text}</p>
        <p class="text-sm text-text-secondary leading-relaxed max-w-2xl mb-6">{siebenMeilen.designAnspruch}</p>
        <figure class="tafel">
          <Image src={tafelW4} alt={siebenMeilen.werkschau.w4.alt}
                 widths={[720, 1080, 1440]} sizes="(min-width: 1024px) 860px, 100vw"
                 format="webp" quality={74} loading="lazy" />
        </figure>
        <p class="text-xs text-text-secondary/80 leading-relaxed mt-3 mb-12">{siebenMeilen.werkschau.w4.label}</p>

        {/* A5 — Crest. Rendert nur mit gesetztem Wert. */}
        {siebenMeilen.crest && (
          <figure class="mt-10 flex justify-center">
            <Image src={siebenMeilen.crest.src} alt={siebenMeilen.crest.alt}
                   width={360} widths={[180, 360]} sizes="180px" format="webp" loading="lazy" />
          </figure>
        )}


        {/* Galerie „Route 7" — horizontale Leiste mit Scroll-Snap, ohne JavaScript.
            Die Leiste ist tastaturbedienbar (tabindex) und als Gruppe ausgezeichnet. */}
        {siebenMeilen.galerieAn && (
          <section class="mt-14" aria-labelledby="route7-titel">
            <h3 id="route7-titel" class="font-serif text-lg font-medium text-text-primary mb-3">
              {siebenMeilen.galerie.titel}
            </h3>
            <p class="text-sm text-text-secondary leading-relaxed max-w-2xl mb-2">
              {siebenMeilen.galerie.intro}
            </p>
            <p class="text-xs text-text-secondary/80 leading-relaxed max-w-2xl mb-6">
              {siebenMeilen.galerie.label}
            </p>

            <ol class="route7" tabindex="0" role="group"
                aria-label="Bildserie Route 7 — sechs Motive, horizontal scrollbar">
              {siebenMeilen.galerie.bilder.map((b, i) => (
                <li class="route7-item">
                  <figure>
                    <Image src={b.src} alt={b.alt}
                           widths={[420, 840]} sizes="(min-width: 640px) 400px, 78vw"
                           format="webp" quality={72}
                           loading={i === 0 ? 'eager' : 'lazy'} />
                    <figcaption class="text-xs text-text-secondary leading-relaxed mt-2">
                      <strong class="text-text-primary font-semibold">{b.stark}</strong>{' '}{b.text}
                    </figcaption>
                  </figure>
                </li>
              ))}
            </ol>
          </section>
        )}

        {/* A8 — O-Ton Daniel. Rendert nur mit gesetztem Wert. */}
        {siebenMeilen.zitat && (
          <blockquote class="mt-10 border-l-2 border-primary pl-5 max-w-2xl">
            <p class="text-base text-text-primary leading-relaxed italic">{siebenMeilen.zitat.text}</p>
            <footer class="text-sm text-text-secondary mt-2">{siebenMeilen.zitat.quelle}</footer>
          </blockquote>
        )}

        <a href={siebenMeilen.link.href} target="_blank" rel="noopener"
           class="seven-link inline-flex items-center gap-1.5 text-sm font-medium mt-10"
           aria-label={siebenMeilen.link.aria}>
          {siebenMeilen.link.label}
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor"
               stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7M9 7h8v8" />
          </svg>
        </a>

      </div>

      {/* Nachbarschaft — damit man von hier aus weiterkommt, ohne zurückzuspringen */}
      <nav aria-label="Weitere Arbeiten" class="mt-16 pt-8 border-t border-border-subtle flex flex-wrap justify-between gap-4 text-sm">
        <a href="/arbeiten/berta/" class="nachbar">← Vorherige Arbeit<span class="sr-only">: berta</span></a>
        <span></span>
      </nav>

    </div>
  </div>
</BaseLayout>

<style>
  .krumen-link { color: var(--color-primary); text-decoration: none; }
  .krumen-link:hover, .krumen-link:focus-visible { text-decoration: underline; text-underline-offset: 3px; }
  .nachbar { color: var(--color-primary); text-decoration: none; }
  .nachbar:hover, .nachbar:focus-visible { text-decoration: underline; text-underline-offset: 3px; }
  /* ── Case 3: 7miles ─────────────────────────────────────────────────── */

  /* Screenshot-Rahmen. Der dünne Rand trennt die dunklen Aufnahmen vom Creme-Grund;
     ohne ihn läuft das Bild ohne Kante in die Karte. */
  .shot {
    margin: 0; border: 1px solid var(--color-border-subtle);
    border-radius: 8px; overflow: hidden; background: var(--color-background-soft);
    line-height: 0;   /* kein Zeilen-Spalt unter dem Bild */
  }
  .shot :global(img) { display: block; width: 100%; height: auto; }

  .seven-link { color: var(--color-primary); text-decoration: none; transition: color 200ms ease; }
  .seven-link:hover, .seven-link:focus-visible {
    color: var(--color-primary-hover);
    text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px;
  }
  /* ── Fliesstext zweispaltig ab 900 px ─────────────────────────────────
     Nur fuer lange Absaetze (gemessen ab ~7 Zeilen bei 672 px) — kuerzere
     zerfallen in zwei Stummel. Spaltenabstand 2rem, damit die Spaltenachse
     auf dem Raster von Ausgangslage/Ziel (lg:gap-8) sitzt; sonst stehen zwei
     verschiedene Achsen uebereinander. */
  .spalten-2 { max-width: none; }
  @media (min-width: 900px) {
    .spalten-2 { columns: 2; column-gap: 2rem; }
  }

  /* ── Flyer-Faecher ────────────────────────────────────────────────────
     Vier Fronten und die gemeinsame Rueckseite, gestaffelt. Angeschnitten
     ist Absicht: der Stapel soll eine Serie behaupten, keine Galerie sein.
     Mitte ist das Paar Vorder-/Rueckseite desselben Blatts. */
  .faecher {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    pointer-events: none;
  }
  .faecher :global(img) {
    flex: 0 0 auto;
    position: relative;
    border-radius: 4px;
    box-shadow: 0 10px 26px rgba(23, 25, 30, .17);
  }
  .faecher :global(.fl-a) { width: 18.5%; margin-left: 0;      z-index: 1;
    transform: rotate(-13deg) translateY(26px); }
  .faecher :global(.fl-b) { width: 21%;   margin-left: -6.5%;  z-index: 2;
    transform: rotate(-7deg) translateY(12px); }
  .faecher :global(.fl-c) { width: 26%;   margin-left: -6%;    z-index: 6;
    transform: rotate(-1.5deg);
    box-shadow: 0 18px 42px rgba(23, 25, 30, .28); }
  .faecher :global(.fl-d) { width: 25.5%; margin-left: -2.5%;  z-index: 5;
    transform: rotate(1.5deg) translateY(4px);
    box-shadow: 0 18px 42px rgba(23, 25, 30, .28); }
  .faecher :global(.fl-e) { width: 21%;   margin-left: -6%;    z-index: 3;
    transform: rotate(9deg) translateY(18px); }

  /* Schmale Viewports: nur das Paar. Fuenf Karten waeren dort ~70 px breit
     und verlieren genau das, was sie zeigen sollen — die Unterschiede. */
  @media (max-width: 700px) {
    .faecher :global(.fl-a),
    .faecher :global(.fl-b),
    .faecher :global(.fl-e) { display: none; }
    .faecher :global(.fl-c) { width: 46%; margin-left: 0; }
    .faecher :global(.fl-d) { width: 45%; margin-left: -2%; }
  }

  /* ── Galerie „Route 7" (7miles-Karte) ───────────────────────────────
     Horizontale Leiste mit Scroll-Snap. Kein JavaScript: das Scrollen macht
     der Browser, Snap sorgt nur dafür, dass Bilder bündig einrasten. */
  .route7 {
    display: flex; gap: 1rem;
    list-style: none; margin: 0; padding: 0 0 .9rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
  }
  .route7-item { flex: 0 0 min(78%, 25rem); scroll-snap-align: start; }
  .route7-item img {
    display: block; width: 100%; height: auto;
    aspect-ratio: 3 / 2; object-fit: cover;   /* fester Kasten: ein neu geliefertes
       Motiv kann die Leiste nicht verschieben, auch wenn es anders proportioniert ist */
    border-radius: .5rem; border: 1px solid var(--color-border-subtle);
  }
  .route7-item figure { margin: 0; }
  /* Tastaturbedienung sichtbar machen — die Leiste ist fokussierbar */
  .route7:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 5px; border-radius: .25rem; }
  .route7::-webkit-scrollbar { height: 8px; }
  .route7::-webkit-scrollbar-thumb { background: var(--color-border-subtle); border-radius: 4px; }
  /* Werkschau-Tafeln: eine Komposition je Disziplin */
  .tafel { margin: 0; }
  .tafel :global(img) {
    display: block; width: 100%; height: auto;
    border-radius: .5rem; border: 1px solid var(--color-border-subtle);
  }
</style>
