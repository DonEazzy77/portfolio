---
import BaseLayout from '../layouts/BaseLayout.astro';

const title       = 'Webdesign & Online-Marketing in Villingen-Schwenningen — Torsten Günter';
// Helix-Variante fuer den Vorschau-Stand: 'H1' | 'H2' | 'H3' (Biz-Nachtrag 29.09.)
const HELIX = 'H1';

const description = 'Website, Onlineshop oder die Abläufe dahinter — ich plane und baue es für kleine Betriebe in Villingen-Schwenningen und im Schwarzwald-Baar-Kreis. Marketing und Technik aus einer Hand, ein Ansprechpartner.';
---

<BaseLayout title={title} description={description}>

  <!-- ── 1. HERO ─────────────────────────────────────────────────── -->
  <!-- overflow-x-clip: die Desktop-Helix darf nach rechts auslaufen, ohne eine
       horizontale Scrollleiste zu erzeugen (NICHT overflow-hidden → kein vertikales Clipping) -->
  <section class="py-20 sm:py-28 overflow-x-clip">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative">

      <!-- Badge-Pill -->
      <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-primary-soft text-primary mb-6">
        Online Marketing · E-Commerce · CRM
      </span>

      {/* HELIX-VARIANTE — Vorschau-Stand fuer Torstens Wahl (Biz-Nachtrag 29.09., Punkt 1).
          'H1' Wortbild: Helix klein, in Textgroesse, hinter „DNA." im Untertitel.
          'H2' Bildmarke: Helix geloest, eigenstaendiges Zeichen rechts im Kopf.
          'H3' ohne Helix im Kopf.
          Nach Torstens Entscheid bleibt eine Variante stehen, die anderen fliegen raus. */}

      <!-- Headline: neue H1 (Biz Zeile 3). Kein „DNA." mehr -> die Helix hat hier keinen Wortanker. -->
      <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-medium text-text-primary leading-tight mb-4 max-w-3xl">
        Websites, Online-Marketing und KI-Automatisierung für kleine Betriebe.
      </h1>

      <!-- Untertitel (Biz Zeile 3) — ersetzt die fruehere Subline (Nachtrag Punkt 2) -->
      <p class="text-lg sm:text-xl text-text-secondary leading-relaxed mb-8 max-w-2xl">
        Marketing und Technik aus einer Hand — mit <span class="text-primary">technischer </span><span class="relative inline-block text-primary">DNA.{HELIX === 'H1' && (
          <img
            src="/dna-hero.png"
            alt=""
            aria-hidden="true"
            class="inline-block align-baseline ml-2 h-[1.15em] w-auto pointer-events-none select-none"
          />
        )}</span>
      </p>

      {HELIX === 'H2' && (
        <img
          src="/dna-hero.png"
          alt=""
          aria-hidden="true"
          class="hidden md:block absolute right-0 top-1/2 -translate-y-1/2 w-[30rem] lg:w-[36rem] max-w-[45vw] h-auto pointer-events-none select-none"
        />
      )}

      {HELIX !== 'H3' && (
        <img
          src="/dna-hero.png"
          alt=""
          aria-hidden="true"
          class="md:hidden mb-8 w-full h-auto pointer-events-none select-none"
        />
      )}

      <!-- Erster Absatz (Biz Zeile 4). Der frühere „10+ Jahre"-Absatz entfällt hier (Nachtrag Punkt 2). -->
      <p class="text-lg text-text-secondary leading-relaxed mb-10 max-w-2xl">
        Ich baue für kleine Betriebe in Villingen-Schwenningen und im Schwarzwald-Baar-Kreis das,
        was zwischen ‚wir sollten mal‘ und ‚läuft‘ liegt: eine Website, die gefunden wird,
        ein Onlineshop, der zum Betrieb passt, und KI-Automatisierung, die Routinearbeit abnimmt.
      </p>

      <!-- CTA-Buttons -->
      <div class="flex flex-wrap gap-4">
        <a
          href="/ueber-mich"
          class="inline-flex items-center px-6 py-3 rounded-lg bg-primary hover:bg-primary-hover text-white font-medium transition-all duration-200"
        >
          Mehr über mich
        </a>
        <a
          href="/kontakt"
          class="inline-flex items-center px-6 py-3 rounded-lg border border-primary text-primary hover:bg-primary-soft font-medium transition-all duration-200"
        >
          Kontakt aufnehmen
        </a>
      </div>

    </div>
  </section>

  <!-- ── 2. DREI DISZIPLINEN ──────────────────────────────────────── -->
  <section class="bg-background-soft py-16 sm:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">

      <h2 class="font-serif text-3xl font-medium text-text-primary mb-4">
        Drei Disziplinen, eine Person.
      </h2>
      <p class="text-text-secondary leading-relaxed mb-12 max-w-xl">
        Selten findet sich jemand, der Marketing, Customer Experience und Web-Technik gleichermaßen versteht.
        Ich tue es seit über 10 Jahren.
      </p>

      <!-- Cards: 1 Spalte → 2 Spalten → 3 Spalten -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

        <article class="bg-background border border-border-subtle rounded-lg p-6 sm:p-8 hover:-translate-y-0.5 hover:border-primary transition-all duration-200">
          <div class="w-8 h-[3px] bg-primary rounded-full mb-5" aria-hidden="true"></div>
          <h3 class="font-serif text-xl font-medium text-text-primary mb-3">
            Websites & Webentwicklung
          </h3>
          <p class="text-sm text-text-secondary leading-relaxed">
            Schnelle, klare Websites — von Hand gebaut statt aus dem Baukasten, so, dass Sie gefunden
            werden und die Seite selbst pflegen können.
          </p>
          <div class="mt-5 pt-4 border-t border-border-subtle">
            <p class="text-xs tracking-[0.16em] uppercase text-primary font-medium mb-1.5">Stack</p>
            <p class="text-sm text-text-secondary leading-relaxed">Astro · Tailwind · Frontend · Git/GitHub · Netlify CI/CD · Claude Code &amp; Multi-Agent</p>
          </div>
        </article>

        <article class="bg-background border border-border-subtle rounded-lg p-6 sm:p-8 hover:-translate-y-0.5 hover:border-primary transition-all duration-200">
          <div class="w-8 h-[3px] bg-primary rounded-full mb-5" aria-hidden="true"></div>
          <h3 class="font-serif text-xl font-medium text-text-primary mb-3">
            Online-Marketing & E-Commerce
          </h3>
          <p class="text-sm text-text-secondary leading-relaxed">
            Sichtbarkeit, die zum Betrieb passt: Suchmaschinen, Google-Unternehmensprofil, Onlineshop
            und die Kanäle dahinter — Strategie und Umsetzung in einer Person.
          </p>
          <div class="mt-5 pt-4 border-t border-border-subtle">
            <p class="text-xs tracking-[0.16em] uppercase text-primary font-medium mb-1.5">Stack</p>
            <p class="text-sm text-text-secondary leading-relaxed">Shopify · Meta Ads · Google Ads · Amazon Seller Central · Plentymarkets · Feed- &amp; Kampagnen-Automation</p>
          </div>
        </article>

        <article class="bg-background border border-border-subtle rounded-lg p-6 sm:p-8 hover:-translate-y-0.5 hover:border-primary transition-all duration-200">
          <div class="w-8 h-[3px] bg-primary rounded-full mb-5" aria-hidden="true"></div>
          <h3 class="font-serif text-xl font-medium text-text-primary mb-3">
            KI-Automatisierung
          </h3>
          <p class="text-sm text-text-secondary leading-relaxed">
            Routinearbeit, die ein Werkzeug übernehmen kann, wird eines: Belege, Anfragen, Texte,
            Abläufe — pragmatisch, ohne dass jemand ein neues System lernen muss.
          </p>
          <div class="mt-5 pt-4 border-t border-border-subtle">
            <p class="text-xs tracking-[0.16em] uppercase text-primary font-medium mb-1.5">Stack</p>
            <p class="text-sm text-text-secondary leading-relaxed">Claude · ChatGPT &amp; DALL-E · eigene Skripte (Python, Shell)</p>
          </div>
        </article>

      </div>
    </div>
  </section>

  <!-- ── 3. AKTUELLER FOKUS ──────────────────────────────────────── -->
  <section class="py-16 sm:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Zweispaltig auf lg+, gestapelt auf Mobile -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">

        <!-- Linke Spalte: Eyebrow + Headline -->
        <div>
          <!-- Bronze-Quadrat als Eyebrow-Marker statt Caps -->
          <p class="flex items-center gap-2 text-sm text-text-secondary mb-4">
            <span class="w-2 h-2 bg-primary rounded-sm shrink-0" aria-hidden="true"></span>
            Aktueller Fokus
          </p>
          <h2 class="font-serif text-3xl font-medium text-text-primary leading-snug">
            KI-Automatisierung für den Alltag im Betrieb.
          </h2>
        </div>

        <!-- Rechte Spalte: Fließtext -->
        <p class="text-base text-text-secondary leading-relaxed">
          Aktuell vertiefe ich meine CRM-Expertise im Studium zum CRM-Manager (IHK, Abschluss 2026)
          und arbeite intensiv an der Verbindung von Customer-Experience-Strategien mit modernen
          KI-Werkzeugen — von Claude und Multi-Agent-Systemen bis zu Marketing-Automatisierung.
          Das Ziel: smarte, datengetriebene Kundenreisen, in denen Mensch und Maschine sinnvoll
          zusammenspielen — statt sich gegenseitig zu ersetzen.
        </p>

      </div>
    </div>
  </section>

  <!-- ── 4. CTA ───────────────────────────────────────────────────── -->
  <section class="bg-background-soft py-20 sm:py-28">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">

      <h2 class="font-serif text-4xl font-medium text-text-primary mb-5">
        Was steht bei Ihnen an?
      </h2>
      <p class="text-lg text-text-secondary leading-relaxed mb-10 max-w-xl mx-auto">
        Auf der Suche nach jemandem, der Marketing und Tech wirklich verbindet?
        Ob Festanstellung, Freelance oder Beratung — ich freue mich auf Ihr Anliegen.
      </p>
      <a
        href="/kontakt"
        class="inline-flex items-center px-8 py-4 rounded-lg bg-primary hover:bg-primary-hover text-white font-medium text-lg transition-all duration-200"
      >
        Kontakt aufnehmen
      </a>

    </div>
  </section>

</BaseLayout>
