---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Seite nicht gefunden — Torsten Günter"
  description="Diese Seite gibt es nicht (mehr). Zurück zur Startseite von torsten-guenter.de."
>
  <section class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-8 sm:pt-28 text-center">
    <p class="text-text-secondary text-sm tracking-[0.18em] uppercase mb-4">Fehler 404</p>

    <h1 class="font-serif text-4xl sm:text-5xl font-medium text-text-primary leading-tight mb-5">
      Hier hast du dich<br />im Wald verlaufen.
    </h1>

    <p class="text-text-secondary mb-10 max-w-md mx-auto">
      Diese Seite gibt es nicht (mehr) — aber der Weg zurück ist nicht weit.
    </p>

    <a
      href="/"
      class="inline-flex items-center justify-center rounded-lg bg-primary px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-primary-hover"
    >
      Zurück zur Startseite
    </a>
  </section>

</BaseLayout>
