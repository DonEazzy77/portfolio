---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';

import shot7milesDesktop from '../assets/showcase/7miles-desktop.png';
import shot7milesMobile from '../assets/showcase/7miles-mobile.png';
import shot7milesKlassen from '../assets/showcase/7miles-unterseite.png';

// Prozess-Schritte (der „Weg dorthin")
const prozess = [
  { t: 'Brand & Konzept', d: 'Bevor eine Zeile Code entstand, stand die Marke — denn eine eigene, wiedererkennbare Identität wirkt schon, bevor das erste Wort gelesen ist. Statt Stockfotos habe ich ein eigenständiges Schwarzwald-Motiv mit Drei-Türme-Wappen entworfen (eine Anspielung auf meine Heimat Unterkirnach), dazu das Schrift-Duo Fraunces + Inter und eine Bronze-Palette. So trägt derselbe ruhige, hochwertige Ton durch alles — vom Wappen bis zur kleinsten Schaltfläche.' },
  { t: 'Design', d: 'Ruhiges, redaktionelles Layout mit klarer Hierarchie: Inhalt und Lesbarkeit führen, Gestaltung unterstützt. Effekte setze ich gezielt dort ein, wo sie den Blick führen statt abzulenken — die Helix hier zum Beispiel.' },
  { t: 'Entwicklung', d: 'Bewusst kein WordPress oder anderes CMS, sondern statisch mit Astro & Tailwind gebaut. Kein Server, keine Datenbank — also nichts, was gehackt wird, langsam lädt oder ständig nach Updates verlangt. Selbst die Schriften liegen lokal: Die Seite lädt, ohne vorher bei Google anzuklopfen (DSGVO-sauber).' },
  { t: 'Go-Live', d: 'Sauber online gebracht, nicht bloß schnell hochgeladen: eigene Domain, Sitemap, Security-Header und Open-Graph gehören für mich dazu. So steht die Seite bei Google ordentlich da — und wer sie teilt, bekommt eine hübsche Vorschau statt eines nackten Links mit kaputtem Bild.' },
  { t: 'Betrieb', d: 'Eine Website ist kein Möbelstück, das man einmal hinstellt und dann vergisst. Also: cookieless Analytics mit Plausible — Besucher verstehen, ganz ohne den Cookie-Banner, den eh niemand mag —, Google Search Console im Blick und laufende Updates. So bleibt sie schnell, sichtbar und aktuell.' },
];

// Ergebnis-Kennzahlen
const ergebnis = [
  { k: '100', v: 'Lighthouse — Best Practices & SEO' },
  { k: '~100', v: 'Accessibility (WCAG-orientiert)' },
  { k: '< 1 s', v: 'Ladezeit der Startseite' },
  { k: '0', v: 'Cookies & externe Fonts (DSGVO)' },
];

// „Das System dahinter" — ein Brand, viele Kontaktpunkte
const digital = [
  { img: '/showcase/tile-website.png', title: 'Website', note: 'torsten-guenter.de',
    alt: 'Startseite von torsten-guenter.de als Browser-Vorschau im Brand-Look',
    lead: 'Statisch gebaut — schnell, sicher, DSGVO-sauber.',
    points: [
      'Astro + Tailwind, Fonts self-hosted (keine Google-Requests)',
      'Kein WordPress oder anderes CMS, keine Datenbank → nichts, was gehackt wird',
      'Unter 1 s Ladezeit, Lighthouse 100 in Best Practices & SEO',
    ] },
  { img: '/showcase/tile-kontaktkarte.png', title: 'Digitale Kontaktkarte', note: 'vCard per QR',
    alt: 'Digitale Kontaktkarte als Smartphone-Vorschau mit Wappen und „Kontakt speichern“',
    lead: 'QR statt Visitenkarten-Stapel — datenschutzbewusst.',
    points: [
      'QR führt auf eine nicht gelistete noindex-Seite',
      'Kontakt wandert mit einem Tipp ins Adressbuch',
      'Online liegen keine privaten Daten frei herum',
    ] },
  { img: '/showcase/tile-signatur.png', title: 'E-Mail-Signatur', note: 'HTML + Text',
    alt: 'Gebrandete E-Mail-Signatur mit Wappen und Bronze-Linie (Kontaktzeile unscharf)',
    lead: 'Markenauftritt bis in jede E-Mail.',
    points: [
      'Gestaltete HTML-Version fürs Auge',
      'Reine Text-Version für Clients ohne HTML',
      'Wappen eingebettet — keine externen Nachladungen',
    ] },
  { img: '/showcase/tile-banner.png', title: 'Social-Banner', note: 'LinkedIn · XING',
    alt: 'Profil-Banner im Schwarzwald-Brand mit Drei-Türme-Wappen',
    lead: 'Ein Layout, sauber auf beide Formate gerechnet.',
    points: [
      'Freigehaltene Zone fürs Profilfoto',
      'Binäre Code-Helix macht die „technische DNA“ sichtbar',
      'Per Skript erzeugt — jederzeit reproduzierbar',
    ] },
];
const printh = [
  { img: '/showcase/card-overlap.png', title: 'Visitenkarte', note: 'Print + QR',
    alt: 'Visitenkarte, Vorder- und Rückseite überlappend, im Brand-Look',
    lead: 'Analog trifft digital — anfassbar und vernetzt.',
    points: [
      'Doppelseitig, 3-mm-Beschnitt + Schnittmarken, druckfertig',
      'QR zeigt auf dieselbe private Kontaktseite wie online',
      'QR-Generator selbst gebaut (Build-Umgebung hatte keine fertige Lib)',
    ] },
  { img: '/showcase/tile-lebenslauf.png', title: 'Lebenslauf', note: 'zwei Varianten',
    alt: 'Zwei Lebenslauf-Varianten gestapelt (Inhalt weichgezeichnet)',
    lead: 'Bewerbung im selben Marken-Look.',
    points: [
      'Zweispaltig und linksbündig, aus denselben Daten gesetzt',
      'Gleiche Schriften & Bronze-Palette wie Web und Druck',
      'Persönliche Daten in der Vorschau bewusst unkenntlich',
    ] },
  { img: '/showcase/tile-geschaeft.png', title: 'Briefpapier & Rechnung', note: 'PDF · Word · Excel',
    alt: 'Briefbogen und Rechnungsvorlage gestapelt (Inhalt weichgezeichnet)',
    lead: 'Ein Briefkopf, drei Wege.',
    points: [
      'PDF-Vorlage, bearbeitbares Word, rechnende Excel-Vorlage',
      'DIN-5008-konform, Wappen-Briefkopf, automatische „Seite X von Y“',
      'Geschäftspost, die zur Marke passt',
    ] },
];

const tech = [
  { func: 'Framework',     tool: 'Astro',        lead: 'Erzeugt superschnelle, statische Seiten.',
    points: ['Liefert fast reines HTML — kaum JavaScript', 'Kein Server/Datenbank nötig → Tempo & Sicherheit'] },
  { func: 'Styling',       tool: 'Tailwind CSS', lead: 'Konsistentes Design ohne CSS-Wildwuchs.',
    points: ['Gestaltung systematisch direkt im Markup', 'Ein durchgängiges Spacing- und Farbsystem'] },
  { func: 'Hosting',       tool: 'Netlify',      lead: 'Liefert die Seite weltweit schnell aus.',
    points: ['Automatischer Deploy bei jedem Git-Push', 'Global verteilt (CDN) → überall kurze Ladezeit'] },
  { func: 'Analytics',     tool: 'Plausible',    lead: 'Besucherstatistik ohne Cookies.',
    points: ['Cookieless — kein Cookie-Banner nötig', 'In der EU entwickelt und gehostet — kein US-Datentransfer'] },
  { func: 'Fonts',         tool: 'Fontsource',   lead: 'Schriften self-hosted statt von Google.',
    points: ['Keine Verbindung zu Google-Servern (DSGVO)', 'Schrift lädt mit der Seite — kein Nachladen'] },
  { func: 'Versionierung', tool: 'Git / GitHub', lead: 'Jede Änderung nachvollziehbar und sicher.',
    points: ['Vollständige Historie — nichts geht verloren', 'Basis für die automatischen Deploys'] },
];

// Eigene, generische Funktions-Icons (Bronze via currentColor) — als HTML-Strings
const techIcons = {
  'Framework':     '<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round"><rect x="9" y="9" width="30" height="30" rx="4"/><path d="M9 20h30M20 9v30"/><rect x="12.5" y="12.5" width="4.5" height="4.5" rx="1" fill="currentColor" stroke="none"/></svg>',
  'Styling':       '<svg viewBox="0 0 48 48" fill="currentColor" stroke="none"><path d="M32 9c4 0 7 3 7 7 0 2-1 4-3 5L23 33l-8-8 13-13c1-2 3-3 4-3z"/><path d="M18 27l3 3-3 4c-2 3-5 2-8 4 2-3 1-6 4-8z"/></svg>',
  'Hosting':       '<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 33a7 7 0 01-1-13.9A9 9 0 0131 16a6 6 0 011.5 11.8"/><path d="M24 36V24M20 28l4-4 4 4"/></svg>',
  'Analytics':     '<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M10 38V10M10 38h28"/><path d="M14 30 22 22 28 26 38 16"/><circle cx="22" cy="22" r="2" fill="currentColor"/><circle cx="28" cy="26" r="2" fill="currentColor"/><circle cx="38" cy="16" r="2" fill="currentColor"/></svg>',
  'Fonts':         '<svg viewBox="0 0 48 48"><text x="24" y="34" text-anchor="middle" font-family="Georgia, serif" font-size="27" font-weight="600" fill="currentColor">Aa</text></svg>',
  'Versionierung': '<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M24 12v24"/><circle cx="24" cy="14" r="3.5" fill="currentColor"/><circle cx="24" cy="24" r="3.5"/><circle cx="24" cy="34" r="3.5"/><path d="M24 14h9M24 24h9M24 34h9" opacity=".55"/></svg>',
};

// ── CASE 3: Fahrschule 7miles ──────────────────────────────────────────────
// Eigenes Case-Objekt, bewusst NICHT die Arrays von Case 1 erweitert (die sind an
// Case 1 gebunden; Auftrag § 4 / Befund § 2).
//
// Copy 1:1 aus selbststaendigkeit/case_study_7miles_entwurf.md v0.4
// (Torsten-Go 20.08.2026, S&R-Kurzpass grün, Nachtrag XLIII). Hier wird kein Wort
// redaktionell geändert — Textfehler werden an Biz gemeldet, nicht behoben.
//
// vorherBild (A4), crest (A5) und zitat (A8) sind bewusst null: die zugehörigen
// Blöcke rendern nur, wenn ein Wert gesetzt ist. Aktivierung = Wert eintragen,
// kein Markup-Umbau, keine Platzhalter-Optik im Live-Output.
const siebenMeilen = {
  eyebrow: 'Kundenprojekt · Fahrschule · 2026',
  titel: 'Fahrschule 7miles',
  disziplinen: 'Rebrand · Website-Neubau · Local SEO · Print',
  // ⚠ ÜBERHOLT — NICHT LIVE STELLEN. Dieser Lead ist v0.4. Biz hat am 20.08. entschieden,
  // ihn aus der Zielgruppen-Analyse neu zu schreiben (v0.5): projektkontext.md § 2 führt DREI
  // gleich wichtige Zielgruppen (BF17 · Motorrad A/A2/A1/AM · Wiedereinsteiger/MPU/Senioren),
  // § 12 verbietet ausdrücklich, eine davon zu priorisieren. Der Satz „Menschen, die gerade 17
  // sind" tut genau das. Beleg: _Hub/Uebergaben/befund_lead_zielgruppe_7miles_2026-08-20.md
  // Beim Austausch erhalten bleiben müssen: „unter zwei Sekunden" (S&R-Auflage W2) und der
  // Kalenderrahmen „Mai – August 2026" (S2) — sonst ist der S&R-Kurzpass für den Absatz hin.
  lead: 'Die Website, die nicht ums Auto geht. Eine Fahrschule im Schwarzwald-Baar-Kreis verkauft keine Fahrstunden, sondern den ersten eigenen Führerschein — an Menschen, die gerade 17 sind und am Handy entscheiden. Daraus wurde ein neuer Markenauftritt und eine statische Website, die auf dem Smartphone in unter zwei Sekunden steht, ohne ein einziges Cookie auskommt und das Google-Profil der Fahrschule gleich mitzieht. Von der ersten Konzeptseite im Mai bis zum Livegang im August 2026.',
  ausgangslage: 'Eine gewachsene WordPress-Seite: sechs Seiten, Fotos in Originalgröße, Texte aus mehreren Jahren, kein einheitliches Erscheinungsbild zwischen Website, Fahrzeug und Drucksachen. Die Fahrschule selbst war stark — vor Ort bekannt, gut bewertet — der Auftritt erzählte das nicht.',
  ziel: 'Eine Marke, die auf Fahrzeugfolie, Postkarte und Smartphone dieselbe ist. Eine Website, die auf dem Handy schnell ist, für alle zugänglich, ohne Tracking, und die in der lokalen Suche sauber auffindbar bleibt — inklusive Weiterleitungen aller alten Adressen.',

  drehTitel: 'Der Dreh nach dem Launch',
  dreh: 'Am Launchtag stand die neue Seite mit Performance 74 auf der Seite „Klassen": sieben Galerie-Vorschaubilder kamen als Vollformat-Fotos für 64-Pixel-Kästchen, ein Stylesheet blockierte das Rendern, ein Preload zeigte auf eine Datei, die der Browser nie nutzte. Zwei Tage später: 385 statt 2.032 KiB, LCP von 8,6 auf unter 2 Sekunden, Performance 99–100. Die Seite war vorher nicht schlecht — sie wurde gemessen, verstanden und fertig gemacht.',
  drehBeleg: 'Gemessen 15. und 17.08.2026, Lighthouse in Chrome DevTools, mobil, fahrschule7miles.de/klassen',

  kpis: [
    { k: '4 × 100', v: 'Lighthouse Startseite, mobil & desktop' },
    { k: '385 KiB', v: 'statt 2.032 KiB — Seite „Klassen", Launch → Optimierung' },
    { k: '0 Cookies', v: 'keine Fremd-Requests, kein Tracking — alle Seiten' },
    { k: '8 Seiten', v: 'Neubau inkl. Redirects der Alt-URLs · Mai – August 2026' },
  ],
  // Pflicht neben K1 (Auftrag § 1.6). Sichtbarer Kleintext statt title-Attribut:
  // ein title-Tooltip erscheint weder auf Touch noch bei Tastaturbedienung.
  kpiBeleg: 'https://fahrschule7miles.de/ · Mobil + Desktop · 20.08.2026 · Lighthouse 13.4.0 (CLI, headless), Median aus je 5 Läufen',

  designAnspruch: 'Das Crest ist so gezeichnet, dass es als Leuchtreklame funktioniert: gleiche Strichstärken, bewusste Unterbrechungen, eine kantige Sieben.',

  link: {
    href: 'https://fahrschule7miles.de',
    label: 'fahrschule7miles.de ansehen',
    aria: 'Website der Fahrschule 7miles öffnen (neues Fenster)',
  },

  shots: [
    { src: shot7milesDesktop, alt: 'Startseite der Fahrschule 7miles auf einem Desktop-Bildschirm: dunkler Hintergrund, grüne Akzentfarbe, Crest und Einstieg zur Schnupperstunde.' },
    { src: shot7milesMobile,  alt: 'Dieselbe Startseite auf dem Smartphone, Menü und Schnupperstunden-Button oben erreichbar.' },
    { src: shot7milesKlassen, alt: 'Seite Klassen der Fahrschule 7miles mit Übersicht der Führerscheinklassen und Galerie.' },
  ],

  vorherBild: null,   // A4 — erst nach Daniel-OK + Motivprüfung
  crest: null,        // A5 — erst nach Daniel-OK pro forma
  zitat: null,        // A8 — erst nach O-Ton Daniel
};
---

{/* Meta 1:1 aus Copy v0.4 Abschnitt 3 (Ruling ⑥). ogTitle/ogDescription als Override,
    weil Social-Karten bei ~70 Zeichen kürzen — Mechanismus seit a0a014d im BaseLayout. */}
<BaseLayout
  title="Arbeiten: Website, Marke & Kundenprojekte — Torsten Günter"
  description="Ausgewählte Arbeiten: das eigene Brand-System und diese Website, die Produktmarke berta und der Relaunch der Fahrschule 7miles — schnell, zugänglich, ohne Cookies."
  ogTitle="Arbeiten: Website, Marke & Kundenprojekte · Torsten Günter"
  ogDescription="Eigene Website, Produktmarke berta, Relaunch Fahrschule 7miles — drei Arbeiten, ein Anspruch: schnell, zugänglich, ohne Cookies."
>
  <div class="py-16 md:py-24 lg:py-32">
    <div
      class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col"
      style="row-gap: clamp(2.5rem, 4vw, 4.5rem);"
    >

      {/* ── INTRO ─────────────────────────────────────────────────────── */}
      <div>
        <p class="flex items-center gap-2 text-sm text-text-secondary mb-5">
          <span class="w-2 h-2 bg-primary rounded-sm shrink-0" aria-hidden="true"></span>
          Arbeiten
        </p>
        <h1 class="font-serif text-4xl sm:text-5xl font-medium text-text-primary leading-tight mb-5">
          Ausgewählte Arbeiten.
        </h1>
        <p class="text-lg text-text-secondary leading-relaxed max-w-2xl">
          Marketing und Technik gehören zusammen — das beweise ich am liebsten an echten Beispielen.
          Hier zeige ich nicht nur, <em>was</em> entstanden ist, sondern <em>wie</em>: vom ersten
          Konzept bis zum laufenden Betrieb.
        </p>
      </div>

      {/* ── CASE STUDY 1: DIESE WEBSITE ───────────────────────────────── */}
      <article id="website" style="scroll-margin-top: 6rem;" class="bg-background border border-border-subtle rounded-lg p-6 sm:p-10">

        <p class="text-xs tracking-[0.18em] uppercase text-text-secondary mb-3">Ausgewählte Arbeit</p>
        <h2 class="font-serif text-2xl sm:text-3xl font-medium text-text-primary leading-tight mb-3">
          Diese Website — und das System dahinter.
        </h2>
        <p class="text-sm text-text-secondary mb-6">Konzept · Design · Entwicklung · Brand-System</p>

        <p class="text-base text-text-primary leading-relaxed max-w-2xl mb-10">
          Du schaust sie dir gerade an. Diese Seite ist meine Handwerksprobe — selbst konzipiert,
          gestaltet und gebaut. Sie behauptet „technische DNA" nicht, sie zeigt sie.
        </p>

        {/* Ausgangslage / Ziel */}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 mb-10">
          <div>
            <div class="w-8 h-[3px] bg-primary rounded-full mb-4" aria-hidden="true"></div>
            <h3 class="font-serif text-lg font-medium text-text-primary mb-2">Ausgangslage</h3>
            <p class="text-sm text-text-secondary leading-relaxed">
              Eine Portfolio-Seite, die meine Verbindung aus Marketing und Technik wirklich belegt —
              kein Baukasten, keine Floskeln, volle Kontrolle über Code, Daten und Marke.
            </p>
          </div>
          <div>
            <div class="w-8 h-[3px] bg-primary rounded-full mb-4" aria-hidden="true"></div>
            <h3 class="font-serif text-lg font-medium text-text-primary mb-2">Ziel</h3>
            <p class="text-sm text-text-secondary leading-relaxed">
              Schnell, barrierearm, markenkonsistent und DSGVO-sauber — eine Seite, die als
              Aushängeschild funktioniert und gleichzeitig zeigt, wie ich arbeite.
            </p>
          </div>
        </div>

        {/* ── Der Weg + Ergebnis als DNA-Spine ──────────────────────────── */}
        <h3 class="font-serif text-lg font-medium text-text-primary mb-6">Der Weg — von der Idee zum Betrieb</h3>
        <p class="text-sm text-text-secondary leading-relaxed max-w-2xl mb-6">
          Diese Seite ist selbst mein Arbeitsbeweis — nicht mit einem Baukasten
          zusammengeklickt, sondern Schritt für Schritt bewusst entschieden. Hier der Weg
          dorthin und warum die Entscheidungen so gefallen sind.
        </p>

        <div class="spine" data-spine>
          <div class="spine-track" data-rail>
            <img class="spine-rail" src="/dna-spine.png" alt="" aria-hidden="true" />
            <ol class="spine-steps">
              {prozess.map((step, i) => (
                <li class="spine-step" data-reveal>
                  <span class="spine-node" aria-hidden="true">
                    <svg viewBox="0 0 100 100" width="40" height="40" role="presentation">
                      <polygon points="50,4 90,27 90,73 50,96 10,73 10,27" fill="currentColor" />
                      <text x="50" y="53" text-anchor="middle" dominant-baseline="central"
                            font-family="Inter, sans-serif" font-weight="700" font-size="42" fill="#fff">{i + 1}</text>
                    </svg>
                  </span>
                  <div class="spine-body">
                    <p class="spine-step-title">{step.t}</p>
                    <p class="spine-step-desc">{step.d}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>

          {/* Zerfalls-Fuß: Strang läuft nach unten aus und fächert breit in Daten auf */}
          <div class="spine-foot" data-reveal aria-hidden="true">
            <img src="/dna-spine-foot.png" alt="" />
          </div>

          <div class="spine-result" data-reveal>
            <p class="spine-result-label">… wird zu messbarem Ergebnis</p>
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
              {ergebnis.map((e) => (
                <div class="bg-background-soft border border-border-subtle rounded-lg p-5 text-center">
                  <p class="font-serif text-2xl sm:text-3xl text-primary mb-1">{e.k}</p>
                  <p class="text-xs text-text-secondary leading-snug">{e.v}</p>
                </div>
              ))}
            </div>
          </div>
        </div>

        {/* ── Das System dahinter ─────────────────────────────────────── */}
        <h3 class="font-serif text-lg font-medium text-text-primary mt-16 sm:mt-20 mb-2">Das System dahinter</h3>
        <p class="text-sm text-text-secondary leading-relaxed max-w-2xl mb-5">
          Eine Marke ist kein Logo, das man draufklebt — sie ist ein System, das an jedem
          Kontaktpunkt <em>gleich</em> klingt. Dieselbe Handschrift trägt vom Bildschirm bis
          aufs Papier: Website, E-Mail-Signatur und Social-Banner genauso wie Visitenkarte,
          Lebenslauf und Briefpapier. Der QR-Code schlägt die Brücke zwischen analog und
          digital — ein Fingertipp auf die gedruckte Karte, und der Kontakt liegt im
          Adressbuch. Zusammengehalten wird alles von derselben „technischen DNA“ — der
          binären Code-Helix, die sich aus meinem Weg zwischen Code und Marke ableitet.
          Dreh die Kacheln um: dahinter steht jeweils, wie und warum sie entstanden sind.
        </p>
        <img src="/dna-divider.png" alt="" aria-hidden="true"
             class="w-full h-12 sm:h-14 object-contain mb-10" />

        {[{ label: 'Digital', items: digital }, { label: 'Print & Hybrid', items: printh }].map((grp) => (
          <div class="mb-10 last:mb-0">
            <p class="text-xs tracking-[0.18em] uppercase text-primary font-medium mb-4">{grp.label}</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 lg:gap-6">
              {grp.items.map((el) => (
                <div class="flip-container" tabindex="0" role="button" aria-pressed="false"
                     aria-label={`${el.title} — ${el.note}. ${el.lead} ${el.points.join('. ')}. Kachel zum Umdrehen.`}
                     data-flip-card>
                  <div class="flip-inner" data-flip-inner aria-hidden="true">
                    <div class="flip-face flip-front">
                      <span class="flip-rotate" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                        </svg>
                      </span>
                      <div class="flip-media"><img src={el.img} alt={el.alt} loading="lazy" /></div>
                      <div class="flip-cap">
                        <span class="flip-cap-title font-serif">{el.title}</span>
                        <span class="flip-cap-tag">{el.note}</span>
                      </div>
                    </div>
                    <div class="flip-face flip-back">
                      <span class="flip-rotate flip-rotate-light" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                        </svg>
