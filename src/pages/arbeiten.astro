<style>
  .spine-track { position: relative; }

  /* Durchgehende, STRUKTURIERTE Helix links (kein Zerfall) — Rückgrat über alle Schritte.
     Wird von den Nodes NICHT unterbrochen. Der Zerfall passiert erst im Fuß darunter. */
  .spine-rail {
    position: absolute; left: 6px; top: 0;
    width: 46px; height: 100%;
    object-fit: cover; object-position: top center;
    opacity: 0.85; pointer-events: none; user-select: none;
    /* Weicher Kopf: die obersten ~9 % faden aus (kein harter Start oben) */
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 9%);
    mask-image: linear-gradient(to bottom, transparent 0, #000 9%);
    /* Startzustand leer; der Füllstand wird per JS SCROLL-GEKOPPELT gesetzt,
       damit die Rail genau so schnell wächst wie die Bullets erscheinen. */
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.12s linear;   /* nur leichtes Glätten beim Scroll */
  }

  .spine-steps { list-style: none; margin: 0; padding: 0;
    display: flex; flex-direction: column; row-gap: 2.5rem; }

  /* Spalte 1 = Node-Gasse (Hexagon ragt RECHTS aus der Helix), Spalte 2 = Text */
  .spine-step { display: grid; grid-template-columns: 104px 1fr;
    column-gap: 1rem; align-items: start; }

  /* Hexagon sitzt am rechten Rand der Gasse (klar rechts der Rail);
     der Arm (::before) zeigt zurück zur Helix = „Base bricht aus". */
  .spine-node { position: relative; justify-self: end; margin-top: 0.1rem;
    width: 40px; height: 40px; color: var(--color-primary); }
  .spine-node::before { content: ""; position: absolute; top: 50%; left: -20px;
    width: 20px; height: 2px; background: var(--color-primary); transform: translateY(-50%); }
  .spine-node svg { display: block; }

  .spine-step-title { font-weight: 600; color: var(--color-text-primary);
    font-size: 0.95rem; margin: 0.15rem 0 0.15rem; }
  .spine-step-desc { color: var(--color-text-secondary);
    font-size: 0.875rem; line-height: 1.6; margin: 0; }

  /* Zerfalls-Fuß: schließt UNTEN an die Rail an und fächert breit in Daten auf.
     Feste Breite + links ausgerichtet, damit der Strang unter der Rail fluchtet
     (Strang liegt bei ~10 % der Bildbreite → ~30px, deckt sich mit der Rail-Mitte). */
  /* Fuß = Zerfall, der EXAKT am Rail-Ende (Kreuzung) ansetzt und nach unten zerstäubt,
     vom Wind leicht nach rechts getragen. Bits im gleichen Maßstab wie die Rail.
     Links auf die Rail (6px) ausgerichtet; margin oben nur minimal negativ, damit der
     Ansatz exakt am Rail-Ende sitzt (nicht höher/niedriger). */
  .spine-foot { margin: -2px 0 0 6px; }
  .spine-foot img { display: block; width: 100px; height: auto; opacity: 0.9; }

  /* Ergebnis wieder hochziehen: der zarte Bit-Schweif des Fußes läuft optisch lang aus
     und würde die Kennzahlen sonst nach unten drücken. Negatives margin holt sie in den
     ausfadenden Schweif zurück (Wert bei Bedarf justieren). */
  .spine-result { margin-top: -6rem; padding-left: calc(104px + 1rem); }
  .spine-result-label { font-size: 0.72rem; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--color-primary); font-weight: 600;
    margin: 0 0 0.9rem; }

  /* Scroll-Reveal — nur aktiv, wenn JS die Klasse gesetzt hat (sonst alles sichtbar) */
  .spine-reveal-ready [data-reveal] { opacity: 0; transform: translateY(12px);
    transition: opacity 0.5s ease, transform 0.5s ease; }
  .spine-reveal-ready [data-reveal].is-visible { opacity: 1; transform: none; }

  /* Mobile: Rail + Fuß ausblenden, Hexagons bleiben als saubere Timeline-Marker */
  @media (max-width: 640px) {
    .spine-rail { display: none; }
    .spine-foot { display: none; }
    .spine-step { grid-template-columns: 52px 1fr; column-gap: 0.85rem; }
    .spine-node { width: 34px; height: 34px; }
    .spine-node svg { width: 34px; height: 34px; }
    .spine-node::before { display: none; }
    .spine-result { padding-left: 0; margin-top: 1.5rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .spine-reveal-ready [data-reveal] { opacity: 1 !important; transform: none !important; transition: none; }
    .spine-rail { clip-path: none !important; transition: none; }
  }

  /* ── Flip-Karten „Das System dahinter" + „Tech & Tools" ── */
  .flip-container { perspective: 1200px; cursor: pointer; }
  .flip-container:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; border-radius: 16px; }
  .flip-inner { position: relative; width: 100%; min-height: 18rem;
    transform-style: preserve-3d; transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1); }
  .flip-inner.is-flipped { transform: rotateY(180deg); }

  .flip-face { position: absolute; inset: 0; backface-visibility: hidden;
    -webkit-backface-visibility: hidden; border-radius: 16px;
    border: 1px solid var(--color-border-subtle); overflow: hidden; background: #fff;
    box-shadow: 0 1px 2px rgba(0,0,0,.04); transition: box-shadow .2s ease, transform .2s ease; }
  .flip-container:hover .flip-inner:not(.is-flipped) .flip-front { box-shadow: 0 12px 28px rgba(146,64,14,.12); transform: translateY(-2px); }

  /* Vorderseite */
  .flip-front { display: flex; flex-direction: column; background: linear-gradient(180deg,#fff,#fdfbf7); }
  .flip-media { flex: 1; display: flex; align-items: center; justify-content: center;
    padding: 1.25rem; min-height: 9.5rem; }
  .flip-media img { max-height: 9.5rem; max-width: 100%; filter: drop-shadow(0 6px 14px rgba(0,0,0,.08)); }
  .flip-media-tech { background: radial-gradient(120% 120% at 30% 20%, #fdf5ea, #f6ede0); }
  .flip-fnicon { display: flex; color: var(--color-primary); }
  /* :global nötig, weil das Icon per set:html injiziert wird und keine scoped-CSS-Kennung trägt */
  .flip-fnicon :global(svg) { width: 58px; height: 58px; }
  .flip-cap { border-top: 1px solid var(--color-border-subtle); display: flex; align-items: baseline;
    justify-content: space-between; gap: .6rem; padding: .75rem .9rem; }
  .flip-cap-text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .flip-cap-title { font-weight: 600; font-size: 1rem; color: var(--color-text-primary); }
  .flip-cap-desc { font-size: 0.72rem; color: var(--color-text-secondary); line-height: 1.2; }
  .flip-cap-tag { font-size: .68rem; color: #fff; background: var(--color-primary);
    padding: .18rem .5rem; border-radius: 999px; white-space: nowrap; }

  /* „Drehen“-Icon oben rechts */
  .flip-rotate { position: absolute; top: .6rem; right: .6rem; z-index: 2; width: 1.9rem; height: 1.9rem;
    border-radius: 50%; border: 1px solid var(--color-border-subtle); background: rgba(255,255,255,.85);
    color: var(--color-primary); display: flex; align-items: center; justify-content: center; }
  .flip-rotate-light { background: rgba(255,255,255,.15); border-color: rgba(255,255,255,.4); color: #fff; }

  /* Rückseite: Bronze */
  .flip-back { transform: rotateY(180deg); background: linear-gradient(160deg,#7a3a10,#92400E);
    color: #fdf3e8; padding: 1.25rem 1.25rem 1.1rem; display: flex; flex-direction: column; }
  .flip-eyebrow { letter-spacing: .16em; text-transform: uppercase; font-size: .66rem; font-weight: 700;
    color: #f0c9a3; margin: 0 0 .4rem; }
  .flip-btitle { font-size: 1.15rem; font-weight: 600; margin: 0 0 .5rem; }
  .flip-lead { font-size: .84rem; line-height: 1.5; margin: 0 0 .65rem; color: #fbe7d4; }
  .flip-points { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: .45rem; }
  .flip-points li { position: relative; padding-left: 1rem; font-size: .78rem; line-height: 1.45; color: #f4ddc7; }
  .flip-points li::before { content: ""; position: absolute; left: 0; top: .45rem; width: 6px; height: 6px;
    background: #f0c9a3; border-radius: 2px; transform: rotate(45deg); }

  @media (prefers-reduced-motion: reduce) { .flip-inner { transition: none; } }

  /* ── berta: Projektkarte „Eigenes Produkt“ — Marken-Exponat auf Creme (#FAF4E6) ── */
  .berta-card { background: #FAF4E6; border: 1px solid rgba(74, 43, 79, .14); }

  /* Text-Lockup (Register C).
     --lockup-w steuert die gesamte Marken-Einheit; alle anderen Werte sind Anteile davon,
     gemessen an berta_lockup_final.svg (viewBox 4701×1872) und gegen das Soll-Bild geprüft:
       Vogel-Tinte linke Kante  0,018 × W
       „b“-Fuß  = Fluchtlinie   0,136 × W
       „a“ rechte Kante         0,981 × W   → Claim-Breite b→a = 0,845 × W
       Wortmarken-Grundlinie    0,380 × W ab Bildoberkante (Bildhöhe = 0,3982 × W)
       Grundlinie → Claim-Oberkante 0,034 × W  (eng getuckt)
     Der Textblock wird um 0,136 × W eingerückt, das Lockup-Bild um denselben Betrag
     zurückgezogen → alles fluchtet unter dem „b“, nur der Vogelkopf ragt links heraus. */
  .berta-text {
    --lockup-w: min(300px, 68vw);
    padding-left: calc(var(--lockup-w) * 0.136);
  }
  @media (min-width: 768px) { .berta-text { --lockup-w: 340px; } }

  .berta-lockup {
    display: block;
    width: var(--lockup-w);
    height: auto;
    margin-left: calc(var(--lockup-w) * -0.136);
  }

  /* Claim: Quicksand Medium, Pflaume voll. font-size steht in viewBox-Einheiten
     (845 Einheiten = 0,845 × W), skaliert also automatisch mit dem Lockup mit. */
  .berta-claim {
    display: block;
    width: calc(var(--lockup-w) * 0.845);
    height: auto;
    margin: calc(var(--lockup-w) * 0.0092) 0 1.5rem;
    overflow: visible;
  }
  .berta-claim text {
    font-family: "Quicksand", var(--font-sans);
    font-weight: 500;
    font-size: 65px;
    fill: #4A2B4F;
  }

  /* Freigestelltes Hero-Keyvisual direkt auf der Creme-Fläche — kein Bild-Kasten, kein Badge */
  .berta-visual { display: flex; justify-content: center; align-items: center; }
  .berta-visual .berta-hero { display: block; width: 100%; max-width: 360px; height: auto; }

  .berta-link { color: var(--color-primary); text-decoration: none; transition: color 200ms ease; }
  .berta-link:hover, .berta-link:focus-visible {
    color: var(--color-primary-hover);
    text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px;
  }

  /* ── Case 3: 7miles ─────────────────────────────────────────────────── */

  /* Screenshot-Rahmen. Der dünne Rand trennt die dunklen Aufnahmen vom Creme-Grund;
     ohne ihn läuft das Bild ohne Kante in die Karte. */
  .shot {
    margin: 0; border: 1px solid var(--color-border-subtle);
    border-radius: 8px; overflow: hidden; background: var(--color-background-soft);
    line-height: 0;   /* kein Zeilen-Spalt unter dem Bild */
  }
  .shot :global(img) { display: block; width: 100%; height: auto; }

  .seven-link { color: var(--color-primary); text-decoration: none; transition: color 200ms ease; }
  .seven-link:hover, .seven-link:focus-visible {
    color: var(--color-primary-hover);
    text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px;
  }
</style>

<script>
  const spine = document.querySelector('[data-spine]');
  if (spine) {
    // Reveal-Zustand erst aktivieren, wenn JS läuft → ohne JS bleibt alles sichtbar
    spine.classList.add('spine-reveal-ready');

    const track  = spine.querySelector('[data-rail]');
    const rail   = spine.querySelector('.spine-rail');
    const steps  = Array.from(spine.querySelectorAll('.spine-step[data-reveal]'));
    const foot   = spine.querySelector('.spine-foot');
    const result = spine.querySelector('.spine-result');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reduce || !track || !rail) {
      // Ohne Bewegung / ohne Rail: alles sofort sichtbar
      [...steps, foot, result].forEach((el) => el && el.classList.add('is-visible'));
      if (rail) (rail as HTMLElement).style.clipPath = 'inset(0 0 0 0)';
    } else {
      let tailShown = false;
      let maxFill = 0;   // höchster erreichter Füllstand → Rail wächst nur, schrumpft nie
      const update = () => {
        const rect = track.getBoundingClientRect();
        if (!rect.height) return;
        const line = window.innerHeight * 0.82;                  // Auslöse-Linie im Viewport
        const tip  = Math.min(Math.max(line - rect.top, 0), rect.height); // Rail-Spitze (Track-Koord.)
        const fill = tip / rect.height;
        if (fill > maxFill) maxFill = fill;                      // einmal gewachsen = bleibt
        // Rail bis zum bisher höchsten Stand füllen → bleibt beim Hochscrollen bestehen
        (rail as HTMLElement).style.clipPath = 'inset(0 0 ' + ((1 - maxFill) * 100).toFixed(2) + '% 0)';
        // Bullet erscheint, sobald die Rail-Spitze seine Höhe erreicht (bleibt sichtbar)
        const reached = maxFill * rect.height;
        steps.forEach((el) => {
          const node = el.querySelector('.spine-node');
          const ref  = node || el;
          const y = ref.getBoundingClientRect().top + (node ? (ref as HTMLElement).offsetHeight / 2 : 0) - rect.top;
          if (reached >= y) el.classList.add('is-visible');
        });
        // Sprengung + Kennzahlen, wenn die Rail unten „ankommt"
        if (!tailShown && maxFill > 0.985) {
          tailShown = true;
          foot && foot.classList.add('is-visible');
          result && setTimeout(() => result.classList.add('is-visible'), 180);
        }
      };
      let ticking = false;
      const onScroll = () => {
        if (ticking) return; ticking = true;
        requestAnimationFrame(() => { update(); ticking = false; });
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      update();
    }
  }
</script>

<script>
  document.querySelectorAll('[data-flip-card]').forEach((card) => {
    const inner = card.querySelector('[data-flip-inner]');
    if (!inner) return;
    const toggle = () => {
      const pressed = card.getAttribute('aria-pressed') === 'true';
      card.setAttribute('aria-pressed', String(!pressed));
      inner.classList.toggle('is-flipped');
      // @ts-ignore
      window.plausible?.('Arbeiten-Kachel gedreht');
    };
    card.addEventListener('click', toggle);
    card.addEventListener('keydown', (event) => {
      if ((event as KeyboardEvent).key === 'Enter' || (event as KeyboardEvent).key === ' ') {
        event.preventDefault();
        toggle();
      }
    });
  });
</script>
