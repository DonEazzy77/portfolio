---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import torstenImage from '../assets/images/torsten.jpeg';
import Spine, { type SpineSchritt } from '../components/Spine.astro';

const hasRealPhoto = true;

interface Value {
  title: string;
  body: string;
}


const values: Value[] = [
  {
    title: 'Schnittstelle mit Doppelwissen',
    body: 'Mein größter Wert entsteht dort, wo zwei Welten sich von alleine selten treffen — Marketing und IT, Strategie und Code, Mensch und System. Ich übersetze, vermittle, erkläre — und lerne in beiden Welten weiter. Wenn am Ende beide Seiten einander besser verstehen, war es ein guter Tag.',
  },
  {
    title: 'Substanz statt Buzzword-Bingo',
    body: 'Marketing ist kein Zauber, es ist Handwerk. Ich rede lieber Klartext über das, was wirklich funktioniert — und auch über das, was nicht funktioniert. Aufgeblasene Schlagworte ohne Inhalt sind mir genauso suspekt wie Tools, die niemand braucht.',
  },
  {
    title: 'Kreativ und technisch geerdet',
    body: 'Ich plane mit Vision, aber nie statisch. Die technische Realität gehört für mich von Anfang an mit ins Konzept — nicht als Bremse, sondern als kreative Mitspielerin. Form und Funktion sind für mich keine Gegner, sondern Sparringspartner.',
  },
];

// Ausbildung und Weiterbildung (v2 § 6) — Wortlaut von Biz, drei Zeilen.
const ausbildung = [
  { titel: 'Fernlehrgang CRM-Manager/in (IHK)', detail: 'laufend, Abschluss offen' },
  { titel: 'Geprüfter Fachkaufmann für Marketing (IHK)', detail: 'berufsbegleitend, 2016–2018' },
  { titel: 'Staatlich geprüfter Informatiker für Multimedia', detail: 'SRH Heidelberg, 2004–2006' },
];

// Werdegang als Erzaehlkapitel auf der Spine (Biz 06.10. § 1: Ziffer sitzt im Knoten,
// das Bronze-Praefix in der Ueberschrift entfaellt).
const stationen: SpineSchritt[] = [
  {
    kopf: "Agentur: Wo Idee und Technik sich zum ersten Mal getroffen haben.",
    text:
      "Angefangen habe ich in einer Agentur als Multimedia-Entwickler — fast sechs Jahre lang. Websites, Content-Management-Systeme, Digital-Signage-Lösungen, Kampagnen, die technisch funktionieren mussten, SEO und SEA von Anfang an. Und ich saß mit am Tisch, wenn Strategien entstanden — für Mittelständler, aber auch für große Firmen und Konzerne. In den letzten beiden Jahren kam der Aufbau von Social-Media-Strategien dazu. Gelernt habe ich dort: Die beste Idee ist nichts wert, wenn sie technisch nicht sauber auf die Straße kommt — und die sauberste Technik ist nichts wert, wenn niemand sie findet. Seitdem denke ich beides zusammen.",
  },
  {
    kopf: "Selbstständig im Schwarzwald: Wie Betriebe wirklich ticken.",
    text:
      "Zurück in der Heimat habe ich als Freelancer Industrie- und Handelsbetriebe in E-Commerce und Online-Marketing beraten und umgesetzt — Strategie, SEO- und SEA-Konzepte, Frontend-Entwicklung. Parallel die Weiterbildung zum Geprüften Fachkaufmann für Marketing (IHK). Gelernt habe ich: Ein Betrieb braucht keine Präsentation mit vierzig Folien, sondern jemanden, der zuhört, das Problem versteht und dann liefert. Diese Zeit ist der Grund, warum ich heute wieder genau das mache.",
  },
  {
    kopf: "Handel von innen: Wie digitaler Verkauf im Alltag funktioniert.",
    text:
      "Vier Jahre habe ich bei einem Sportfachhändler alles verantwortet, was digital war: den Onlineshop und die Marktplätze, Multichannel-Vertrieb, SEO und SEA, die Online-Kundenbetreuung — und die Technik im Laden, von der Kasseneinrichtung über Drucker bis zur Hardware-Beschaffung. Wenn es eng wurde, habe ich auch selbst gepickt, gepackt und mich um Retouren gekümmert. Danach zwei Jahre bei einem Hersteller von Musterkoffern und Reisegepäck mit eigener patentierter Technik — B2B und B2C, mehrere Shops, Performance-Marketing und Conversion-Optimierung, Produktmanagement und Vermarktung der Kollektionen, dazu die komplette Online-Kundenbetreuung. Gelernt habe ich, was man von außen nicht sieht: Online-Marketing endet nicht beim Klick. Es geht weiter im Lager, an der Kasse, im Kundengespräch. Diesen Blick bringe ich in jedes Projekt mit.",
  },
  {
    kopf: "Heute: Marketing, Technik und KI — aus einer Hand.",
    text:
      "Seit 2024 baue ich das zusammen, was ich auf allen drei Stationen gelernt habe: Websites, die gefunden werden, Onlineshops, die zum Betrieb passen, und KI-Automatisierung, die Routinearbeit abnimmt. Ich arbeite mit KI-Assistenten in klar getrennten Rollen und festen Übergaben — so, wie ein kleines Team arbeiten würde. Und ich bilde mich weiter — im Fernlehrgang zum CRM-Manager (IHK), weil Kundenbeziehung die Stelle ist, an der Marketing und Technik sich am härtesten begegnen.",
  },
];

---

<BaseLayout
  title="Über mich — Torsten Günter"
  description="Selbstständig in Unterkirnach im Schwarzwald: Webdesign, Online-Marketing und KI-Automatisierung für kleine und mittlere Betriebe. Mein Weg dorthin — Agentur, Freelance, Handel — und was mich antreibt."
>

  {/*
    Spacing-Konvention (siehe skills.astro / kontakt.astro / Memory):
      • Page-Wrapper:  py-16 md:py-24 lg:py-32
      • Sektionen:     flex flex-col + Inline-Style row-gap: clamp(...)
      • Grids:         Inline-Style display:grid + repeat(auto-fit, minmax(...))
    Tailwind gap-* / grid-cols-* sind in diesem Setup unzuverlässig.
  */}
  <div class="py-16 md:py-24 lg:py-32">

    <div
      class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col"
      style="row-gap: clamp(2.5rem, 4vw, 4.5rem);"
    >

      {/* ── 1. HERO (zweispaltig: Text + Foto-Stack mit Mini-Qualifikationen) ── */}
      <section>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: clamp(1.5rem, 4vw, 3rem); align-items: center;">

          {/* LEFT: Text */}
          <div>
            <p class="flex items-center gap-2 text-sm text-text-secondary mb-5">
              <span class="w-2 h-2 bg-primary rounded-sm shrink-0" aria-hidden="true"></span>
              Über mich
            </p>
            <h1 class="font-serif text-4xl sm:text-5xl font-medium text-text-primary leading-tight mb-5">
              Marketing und Technik — warum ich beides mache.
            </h1>
            <p class="text-lg text-text-secondary leading-relaxed" style="max-width: 440px;">
              Wer ich bin, wo ich herkomme, und warum ein Betrieb bei mir nicht zwischen Agentur und IT-Dienstleister wählen muss.
            </p>
          </div>

          {/* RIGHT: Profil-Card (Akzentlinie, Foto, Separator, Eyebrow, Qualifikationen) */}
          <div class="flex justify-center">
            <article class="profile-card">

              {/* Bronze-Akzentlinie (wie auf den Werte-Cards) */}
              <div class="profile-accent" aria-hidden="true"></div>

              {/*
                Foto-Container (Kreis, Bronze-Border, Bronze-Soft-BG als Platzhalter-Fläche).
                `overflow: hidden` sorgt dafür, dass `object-fit: cover` sauber im Kreis greift.
                aria-hidden nur, solange der TG-Initialen-Fallback aktiv ist.
              */}
              <div
                class="profile-photo"
                aria-hidden={hasRealPhoto ? undefined : 'true'}
              >
                {hasRealPhoto ? (
                  <Image
                    src={torstenImage}
                    alt="Torsten Günter"
                    width={220}
                    height={220}
                    loading="eager"
                    style="width: 100%; height: 100%; object-fit: cover; display: block;"
                  />
                ) : (
                  <span class="profile-initials">TG</span>
                )}
              </div>

              {/* Subtiler Separator zwischen Foto und Text-Block */}
              <hr class="profile-separator" />

              {/* Eyebrow „Profil auf einen Blick" mit Bronze-Punkt (::before) */}
              <p class="profile-eyebrow">Profil auf einen Blick</p>

              {/* Quick-Facts: <strong> für Label, <span class="qual-note"> für Wert.
                   Klassen analog zur vormaligen Qualifikationen-Liste, damit Styling
                   konsistent bleibt. Ausbildungs-Details stehen jetzt im dedizierten
                   Ausbildungs-Block unterhalb des Werdegangs. */}
              <ul class="profile-quals">
                <li><strong>Erfahrung</strong><span class="qual-note">— 15+ Jahre Marketing &amp; Tech</span></li>
                <li><strong>Leistungen</strong><span class="qual-note">— Websites · Online-Marketing · E-Commerce · KI-Automatisierung</span></li>
                <li><strong>Standort</strong><span class="qual-note">— Unterkirnach bei Villingen-Schwenningen · vor Ort und remote</span></li>
                <li><strong>Arbeitsweise</strong><span class="qual-note">— Strategie und Umsetzung in einer Person</span></li>
              </ul>

            </article>
          </div>

        </div>
      </section>

      {/* ── 2. EINSTIEG (v2 § 3) ── */}
      <section class="max-w-3xl mx-auto w-full">
        <p class="text-text-secondary" style="font-size: 17px; line-height: 1.7;">
          Meine Ausbildung war technisch, mein Beruf wurde das Marketing — und der interessante Teil liegt seitdem genau dazwischen. Seit über fünfzehn Jahren arbeite ich an dieser Schnittstelle: in der Agentur, als selbstständiger Berater und im Handel, wo ich den Online-Vertrieb verantwortet habe. Ich frage zuerst, wie etwas funktioniert, und dann, wie es Kunden bringt. Aktuell bilde ich mich zum CRM-Manager (IHK) weiter.
        </p>
      </section>

      {/* ── 3. WERTE-STATEMENTS (3 Cards) ───────────────────────────── */}
      <section>
        <p class="flex items-center gap-2 text-sm text-text-secondary mb-4">
          <span class="w-2 h-2 bg-primary rounded-sm shrink-0" aria-hidden="true"></span>
          Was mich antreibt
        </p>
        <h2 class="font-serif text-2xl sm:text-3xl font-medium text-text-primary mb-8">
          Drei Werte, die meine Arbeit prägen.
        </h2>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: clamp(1rem, 2vw, 1.5rem);">
          {values.map((value) => (
            <article class="value-card">
              <div class="w-8 h-[3px] bg-primary rounded-full mb-5" aria-hidden="true"></div>
              <h3 class="font-serif font-medium text-text-primary mb-3" style="font-size: 21px; line-height: 1.3;">
                {value.title}
              </h3>
              <p class="text-text-secondary" style="font-size: 14.5px; line-height: 1.65;">
                {value.body}
              </p>
            </article>
          ))}
        </div>
      </section>

      {/* ── 4. WERDEGANG als EIN Erzaehlblock (v2 § 5) — ersetzt Story-Zeitstrahl.
          Keine Jahreszahlen ausser "Seit 2024" in Kapitel 4, keine Firmennamen. */}
      <section class="mx-auto w-full" style="max-width: 878px;">
        <p class="flex items-center gap-2 text-sm text-text-secondary mb-4">
          <span class="w-2 h-2 bg-primary rounded-sm shrink-0" aria-hidden="true"></span>
          Werdegang
        </p>
        <h2 class="font-serif text-2xl sm:text-3xl font-medium text-text-primary mb-3">
          Vier Stationen, ein roter Faden.
        </h2>
        <p class="text-text-secondary leading-relaxed mb-8">
          Was ich wo gelernt habe — und was Sie davon haben.
        </p>

        <Spine schritte={stationen} stil="erzaehlung" />
      </section>

      {/* ── 5. AUSBILDUNG UND WEITERBILDUNG (v2 § 6) — drei Zeilen mit Jahren ── */}
      <section class="max-w-3xl mx-auto w-full">
        <p class="flex items-center gap-2 text-sm text-text-secondary mb-4">
          <span class="w-2 h-2 bg-primary rounded-sm shrink-0" aria-hidden="true"></span>
          Ausbildung
        </p>
        <h2 class="font-serif text-2xl sm:text-3xl font-medium text-text-primary mb-8">
          Ausbildung und Weiterbildung.
        </h2>

        <ul class="flex flex-col gap-4">
          {ausbildung.map((zeile) => (
            <li class="text-text-secondary" style="font-size: 17px; line-height: 1.6;">
              <strong class="font-medium text-text-primary">{zeile.titel}</strong> — {zeile.detail}
            </li>
          ))}
        </ul>

        {/* ── Lebenslauf-Download (v2 § 7). Datei liegt unter public/dokumente/,
             per _headers auf noindex, nofollow gesetzt. ── */}
        <div class="bg-background-soft border border-border-subtle rounded-lg mt-10" style="padding: clamp(1.25rem, 3vw, 1.75rem);">
          <p class="text-text-secondary mb-4" style="font-size: 16.5px; line-height: 1.6;">
            Der vollständige Lebenslauf mit allen Stationen und Jahreszahlen — als PDF.
          </p>
          <a
            href="/dokumente/Torsten_Guenter_Lebenslauf.pdf"
            type="application/pdf"
            download
            class="inline-flex items-center px-6 py-3 rounded-lg bg-primary text-white font-medium transition-all duration-200 hover:bg-primary-hover"
          >
            Lebenslauf herunterladen (PDF)
          </a>
        </div>
      </section>

      {/* ── 6. CLOSING-CTA ──────────────────────────────────────────── */}
      <section>
        <div class="bg-background-soft rounded-lg text-center" style="padding: clamp(2.5rem, 5vw, 4rem) clamp(1.5rem, 4vw, 3rem);">
          <div class="max-w-md mx-auto">
            <h2 class="font-serif text-2xl sm:text-3xl font-medium text-text-primary mb-3">
              Was steht bei Ihnen an?
            </h2>
            <p class="text-text-secondary mb-8" style="font-size: 16.5px; line-height: 1.6;">
              Schreiben Sie mir gerne — ich freue mich auf den Austausch.
            </p>
            <a
              href="/kontakt"
              class="inline-flex items-center px-6 py-3 rounded-lg bg-primary text-white font-medium transition-all duration-200 hover:bg-primary-hover"
              style="text-decoration: none;"
            >
              Kontakt aufnehmen
            </a>
          </div>
        </div>
      </section>

    </div>
  </div>

</BaseLayout>

<style>
  /* ── Werte-Cards ───────────────────────────────────────────────────── */
  .value-card {
    background: #FFFFFF;
    border: 1px solid var(--color-border-subtle);
    border-radius: 0.5rem;
    padding: 1.5rem 1.75rem;
    transition: transform 200ms ease, border-color 200ms ease;
  }
  .value-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-primary);
  }

  /* ── Profil-Card (Hero, rechte Spalte) ───────────────────────────────── */
  .profile-card {
    background: #FFFFFF;
    border: 0.5px solid var(--color-border-subtle);
    border-radius: 12px;
    padding: 1.5rem;
    max-width: 420px;
    width: 100%;
    position: relative;
  }

  .profile-accent {
    width: 32px;
    height: 3px;
    background: var(--color-primary);
    border-radius: 9999px;
    margin: 0 auto 1rem;
  }

  .profile-photo {
    width: 220px;
    height: 220px;
    border-radius: 50%;
    border: 1.5px solid var(--color-primary);
    background: var(--color-primary-soft);
    margin: 0 auto 1.125rem;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .profile-photo {
      width: 160px;
      height: 160px;
    }
  }

  .profile-initials {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 44px;
    color: var(--color-primary);
    line-height: 1;
  }

  .profile-separator {
    border: none;
    border-top: 0.5px solid var(--color-border-subtle);
    margin: 0 0 1rem;
  }

  .profile-eyebrow {
    display: flex;
    align-items: center;
    column-gap: 0.5rem;
    font-size: 11.5px;
    letter-spacing: 0.02em;
    color: var(--color-text-secondary);
    margin: 0 0 0.625rem;
  }
  .profile-eyebrow::before {
    content: '';
    width: 5px;
    height: 5px;
    background: var(--color-primary);
    border-radius: 50%;
    flex-shrink: 0;
  }

  .profile-quals {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    row-gap: 0.5rem;
  }
  .profile-quals li {
    font-size: 12.5px;
    line-height: 1.45;
  }
  .profile-quals strong {
    font-weight: 500;
    color: var(--color-text-primary);
  }
  .qual-note {
    font-weight: 400;
    color: var(--color-text-secondary);
    margin-left: 0.25rem;
  }
</style>
